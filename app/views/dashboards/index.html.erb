<% content_for :title, "나의 강의실" %>

<div class="w-full max-w-6xl mx-auto py-8 px-4">

<!-- 학습자 강의실 디자인 기본 설계 -->
  <div class="mb-8 pb-5 border-b border-stone-200">
    <h1 class="font-bold text-3xl text-stone-900 tracking-tight">나의 강의실</h1>
    <p class="text-stone-500 mt-1 text-base">
      <strong class="text-emerald-700 font-semibold"><%= current_user.name %></strong> 학습자님, 환영합니다! 오늘도 배움을 통해 한 걸음 성장해 보세요.
    </p>
  </div>

  <!-- 대관 신청 내역 및 안내 퀵 카드 -->
  <div class="mb-10 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-white p-5 rounded-xl border border-stone-200 shadow-sm flex items-center justify-between hover:border-emerald-300 transition duration-200">
      <div class="flex items-center gap-3.5">
        <span class="text-2xl p-2.5 bg-emerald-50 rounded-lg border border-emerald-100">📋</span>
        <div>
          <h2 class="font-bold text-stone-900 text-base">나의 대관 신청 내역</h2>
          <p class="text-stone-500 text-xs mt-0.5">신청하신 시설의 승인 상태와 이용 예약을 확인합니다.</p>
        </div>
      </div>
      <%= link_to "내역 보기", facility_reservations_path, 
          class: "shrink-0 px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-lg shadow-sm transition duration-200" %>
    </div>

    <div class="bg-white p-5 rounded-xl border border-stone-200 shadow-sm flex items-center justify-between hover:border-emerald-300 transition duration-200">
      <div class="flex items-center gap-3.5">
        <span class="text-2xl p-2.5 bg-stone-100 rounded-lg border border-stone-200">🏛️</span>
        <div>
          <h2 class="font-bold text-stone-900 text-base">대관 시설 안내 & 신청</h2>
          <p class="text-stone-500 text-xs mt-0.5">학습관 내 강의실 및 세미나실 대관을 신청합니다.</p>
        </div>
      </div>
      <%= link_to "시설 둘러보기", facilities_path, 
          class: "shrink-0 px-4 py-2 bg-stone-800 hover:bg-stone-900 text-white font-bold text-xs rounded-lg shadow-sm transition duration-200" %>
    </div>
  </div>

  <% if @enrolled_courses.empty? %>
<!-- 전체 강좌의 보러가기 디자인 및 링크 -->
    <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-200 border-dashed max-w-2xl mx-auto mt-10">
      <span class="text-5xl block mb-4">📖</span>
      <p class="text-xl text-stone-600 font-semibold">현재 수강 중인 강좌가 없습니다.</p>
      <p class="text-stone-400 mt-2 text-sm mb-6">시민들을 위해 준비한 다양하고 유익한 평생교육 과정을 만나보세요.</p>
      <%= link_to "전체 강좌 보러가기", courses_path,
          class: "inline-block rounded-xl px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-base shadow-sm transition duration-200" %>
    </div>
  
  <% else %>
    <div class="mb-6 flex justify-between items-center">
      <span class="text-stone-600 font-medium">
        총 <strong class="text-emerald-700 font-bold"><%= @enrolled_courses.count %>개</strong>의 강좌를 수강하고 있습니다.
      </span>
      <%= 
        link_to "추가 강좌 신청하기", courses_path,
        class: "text-sm text-emerald-700 hover:text-emerald-900 font-semibold transition"
      %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
      <% @enrolled_courses.each do |course| %>
        <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition duration-200">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="inline-block bg-stone-100 text-stone-700 text-xs font-semibold px-2.5 py-1 rounded-full">
                <%= course.category&.name || "일반 분류" %>
              </span>
              <span class="inline-block bg-emerald-50 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-md border border-emerald-200">
                수강 중
              </span>
            </div>

            <h2 class="font-bold text-xl text-stone-900 mb-2 truncate">
              <%= course.title %>
            </h2>

            <p class="text-stone-600 text-sm mb-3">
              <strong>담당 강사:</strong><%= course.instructor_name %> 선생님
            </p>

            <p class="text-stone-500 text-sm line-clamp-2 mb-4 leading-relaxed">
              <%= course.description %>
            </p>
          </div>

          <div class="mt-4 pt-4 border-t border-stone-100">
            <div class="flex items-center justify-between mb-4 text-xs text-stone-500">
              <span>현재 수강 인원</span>
              <span><strong class="text-stone-800 font-semibold"><%= course.registrations.count %></strong> / <%= course.max_students %>명</span>
            </div>

            <div class="grid grid-cols-2 gap-2">
              <%= link_to "강의실 입장", course, class: "rounded-lg py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-center text-sm border border-emerald-200 transition" %>

              <%= link_to "수강 취소", course_registration_path(course_id: course.id, id: :current), 
                  data: { turbo_method: :delete, turbo_confirm: "정말로 이 강좌의 수강신청을 취소하시겠습니까?" }, 
                  class: "rounded-lg py-2 bg-stone-50 hover:bg-red-50 hover:text-red-600 hover:border-red-200 text-stone-600 font-medium text-center text-sm border border-stone-200 transition" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  </div>
</div>