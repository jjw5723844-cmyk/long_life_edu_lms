<% content_for :title, "수강 신청 및 감면/환불 종합 관리" %>

<div class="w-full max-w-7xl mx-auto py-8 px-4 space-y-8">
  <!-- 상단 타이틀 -->
  <div class="border-b border-stone-200 pb-5">
    <h1 class="text-3xl font-bold text-stone-900 tracking-tight">🎓 수강 신청 & 감면/환불 승인 관리</h1>
    <p class="text-stone-500 text-sm mt-1">감면 증빙 검토, 정원 초과 대기자 관리, 평생교육법 기준 환불 정산을 처리합니다.</p>
  </div>

  <!-- 감면 혜택 신청 검토 및 승인 대기 목록 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200 flex justify-between items-center">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        수강료 감면 증빙 검토 대기
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-md border border-emerald-200">
        <%= @pending_discounts.count %>건 대기 중
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">신청자</th>
            <th class="p-3">강좌명</th>
            <th class="p-3">감면 구분</th>
            <th class="p-3">증빙 서류</th>
            <th class="p-3 text-right">관리 조치</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @pending_discounts.any? %>
            <% @pending_discounts.each do |reg| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-semibold text-stone-800"><%= reg.user.name %></td>
                <td class="p-3 text-stone-700"><%= reg.course.title %></td>
                <td class="p-3 text-stone-600"><%= reg.discount_type.presence || "미지정" %></td>
                <td class="p-3 text-stone-500 font-mono text-xs"><%= reg.discount_proof.presence || "첨부 확인 필요" %></td>
                <td class="p-3 text-right space-x-1">
                  <%= button_to "승인", approve_discount_admin_course_registration_path(reg), method: :patch,
                      class: "px-3 py-1 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-lg transition inline-block"
                  %>
                  <%= button_to "반려", reject_discount_admin_course_registration_path(reg), method: :patch,
                      class: "px-3 py-1 bg-stone-200 hover:bg-stone-300 text-stone-700 text-xs font-semibold rounded-lg transition inline-block"
                  %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="p-6 text-center text-stone-400 text-sm">검토 대기 중인 감면 신청이 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 정원 초과 대기자 순번 관리 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        대기자 대기 순번 현황
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">순번</th>
            <th class="p-3">대기자명</th>
            <th class="p-3">신청 강좌</th>
            <th class="p-3">신청일시</th>
            <th class="p-3 text-right">상태</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @waitlist_registrations.any? %>
            <% @waitlist_registrations.each do |reg| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-bold text-emerald-800">No. <%= reg.waitlist_position || "-" %></td>
                <td class="p-3 font-semibold text-stone-800"><%= reg.user.name %></td>
                <td class="p-3 text-stone-700"><%= reg.course.title %></td>
                <td class="p-3 text-stone-400 text-xs"><%= reg.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="p-3 text-right">
                  <span class="px-2 py-0.5 bg-stone-100 text-stone-600 font-semibold text-xs rounded border border-stone-200">대기중</span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="p-6 text-center text-stone-400 text-sm">현재 등록된 대기자가 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 수강 확정 및 환불 정산 내역 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        수강 내역 및 포기/환불 정산
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">학습자</th>
            <th class="p-3">강좌명</th>
            <th class="p-3">결제 금액</th>
            <th class="p-3">환불 확정액</th>
            <th class="p-3">상태</th>
            <th class="p-3 text-right">취소/환불 처리</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @completed_registrations.any? %>
            <% @completed_registrations.each do |reg| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-semibold text-stone-800"><%= reg.user.name %></td>
                <td class="p-3 text-stone-700"><%= reg.course.title %></td>
                <td class="p-3 text-stone-600"><%= reg.paid_amount.to_i %>원</td>
                <td class="p-3 font-bold text-emerald-800"><%= reg.refund_amount.to_i %>원</td>
                <td class="p-3">
                  <% if reg.confirmed? %>
                    <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-xs font-bold rounded border border-emerald-200">수강 확정</span>
                  <% elsif reg.refunded? %>
                    <span class="px-2 py-0.5 bg-stone-200 text-stone-700 text-xs font-bold rounded border border-stone-300">환불 완료</span>
                  <% else %>
                    <span class="px-2 py-0.5 bg-stone-100 text-stone-500 text-xs font-medium rounded border border-stone-200">취소됨</span>
                  <% end %>
                </td>
                <td class="p-3 text-right">
                  <% if reg.confirmed? %>
                    <%= button_to "취소 및 환불 실행", process_refund_admin_course_registration_path(reg), method: :patch,
                        class: "px-3 py-1 bg-stone-800 hover:bg-stone-900 text-white text-xs font-semibold rounded-lg transition inline-block"
                    %>
                  <% else %>
                    <span class="text-xs text-stone-400">정산 완료</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="p-6 text-center text-stone-400 text-sm">등록된 수강 처리 내역이 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>