<% content_for :titel, "강의실 및 시설 대관 승인 관리" %>

<div class="w-full max-w-7xl mx-auto py-8 px-4 space-y-8">
  <!-- 상단 타이틀 영역 -->
  <div class="border-b border-stone-200 pb-5">
    <h1 class="text-3xl font-bold text-stone-900 tracking-tight">🏛️ 시설 대관 중복 방지 & 승인 관리</h1>
    <p class="text-stone-500 text-sm mt-1">강의실 및 강당 대관 신청 건에 대한 중복 검증 상태를 확인하고 승인/반려를 처리합니다.</p>
  </div>

  <!-- 시설 대관 승인 대기 목록 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200 flex justify-between items-center">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        대관 승인 신청 대기
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-md border border-emerald-200">
        <%= @pending_reservations.count %>건 대기 중
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">대관 신청 시설명</th>
            <th class="p-3">신청자</th>
            <th class="p-3">예약 일자</th>
            <th class="p-3">사용 시간</th>
            <th class="p-3">사용 목적</th>
            <th class="p-3 text-right">승인 조치</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @pending_reservations.any? %>
            <% @pending_reservations.each do |res| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-semibold text-stone-800"><%= res.facility.name %></td>
                <td class="p-3 text-stone-700"><%= res.user.name %></td>
                <td class="p-3 font-mono text-stone-600"><%= res.reservation_date %></td>
                <td class="p-3 font-mono text-emerald-800 font-bold"><%= res.start_time %> ~ <%= res.end_time %></td>
                <td class="p-3 text-stone-600"><%= res.purpose.presence || "대관 이용 목적 미기재" %></td>
                <td class="p-3 text-right space-x-1">
                  <%= button_to "승인", approve_admin_facility_reservation_path(res), method: :patch,
                      class: "px-3 py-1 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-lg transition inline-block"
                  %>
                  <%= button_to "반려", reject_admin_facility_reservation_path(res), method: :patch,
                      class: "px-3 py-1 bg-stone-200 hover:bg-stone-300 text-stone-700 text-xs font-semibold rounded-lg transition inline-block"
                  %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="p-6 text-center text-stone-400 text-sm">승인 대기 중인 대관 신청이 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 대관 승인 및 처리 이력 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        최근 대관 처리 완료 이력
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">대관 신청 시설명</th>
            <th class="p-3">신청자</th>
            <th class="p-3">예약 일시</th>
            <th class="p-3 text-right">처리 결과</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @processed_reservations.any? %>
            <% @processed_reservations.each do |res| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-semibold text-stone-800"><%= res.facility.name %></td>
                <td class="p-3 text-stone-700"><%= res.user.name %></td>
                <td class="p-3 font-mono text-stone-600"><%= res.reservation_date %> (<%= res.start_time %> ~ <%= res.end_time %>)</td>
                <td class="p-3 text-right">
                  <% if res.approved? %>
                    <span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 text-xs font-bold rounded border border-emerald-200">승인 완료</span>
                  <% else %>
                    <span class="px-2 py-0.5 bg-stone-200 text-stone-700 text-xs font-bold rounded border border-stone-300">반려됨</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="p-6 text-center text-stone-400 text-sm">대관 처리 이력이 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>