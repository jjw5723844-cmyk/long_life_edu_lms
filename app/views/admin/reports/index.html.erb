<% content_for :title, "평생학습관 행정 통계 및 데이터 출력" %>

<div class="w-full max-w-7xl mx-auto py-8 px-4 space-y-8">
  <!-- 상단 타이틀 및 CSV 내보내기 버튼 영역 -->
  <div class="border-b border-stone-200 pb-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-stone-900 tracking-tight">📊 행정 통계 & 데이터 내보내기</h1>
      <p class="text-stone-500 text-sm mt-1">수강신청, 수강료 수입, 강좌 충원율 등 핵심 행정 지표를 확인하고 데이터를 CSV로 추출합니다.</p>
    </div>
    <div>
      <!-- CSV 다운로드 버튼 -->
      <%= link_to export_csv_admin_reports_path, class: "inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-semibold rounded-lg shadow-sm transition" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        전체 수강신청 CSV 추출
      <% end %>
    </div>
  </div>

  <!-- 주요 행정 지표 (KPI) 카드 영역 -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- 총 수강료 수입 -->
    <div class="bg-white p-5 rounded-xl border border-stone-200 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 uppercase">총 수강료 수입</span>
        <span class="w-2 h-2 rounded-full bg-emerald-700"></span>
      </div>
      <div class="text-2xl font-bold text-stone-900 font-mono">
        <%= number_to_currency(@total_revenue, unit: "₩", precision: 0) %>
      </div>
      <p class="text-xs text-stone-400">승인 완료된 수강료 합계</p>
    </div>

    <!-- 승인 완료 수강생 -->
    <div class="bg-white p-5 rounded-xl border border-stone-200 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 uppercase">승인 완료 수강생</span>
        <span class="w-2 h-2 rounded-full bg-emerald-700"></span>
      </div>
      <div class="text-2xl font-bold text-stone-900 font-mono">
        <%= @approved_count %>명
      </div>
      <p class="text-xs text-stone-400">대기 중: <%= @pending_count %>명 / 환불: <%= @refunded_count %>명</p>
    </div>

    <!-- 총 개설 강좌 수 -->
    <div class="bg-white p-5 rounded-xl border border-stone-200 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-stone-500 uppercase">총 개설 강좌 수</span>
        <span class="w-2 h-2 rounded-full bg-emerald-700"></span>
      </div>
      <div class="text-2xl font-bold text-stone-900 font-mono">
        <%= @total_courses %>개
      </div>
      <p class="text-xs text-stone-400">현재 등록된 전체 평생학습 강좌</p>
    </div>
  </div>

  <!-- 강좌별 세부 실적 및 충원율 현황 표 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200 flex justify-between items-center">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        강좌별 등록 및 수입 현황 상세
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 bg-stone-200 text-stone-700 rounded-md border border-stone-300">
        총 <%= @course_stats&.size || 0 %>개 강좌
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">강좌 ID</th>
            <th class="p-3">강좌명</th>
            <th class="p-3">담당 강사</th>
            <th class="p-3 text-center">정원 / 승인 인원</th>
            <th class="p-3 text-right">총 결제 수입</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @course_stats&.any? %>
            <% @course_stats.each do |stat| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-mono text-xs text-stone-400">#<%= stat[:id] %></td>
                <td class="p-3 font-semibold text-stone-800"><%= stat[:title] %></td>
                <td class="p-3 text-stone-600"><%= stat[:instructor_name] %></td>
                <td class="p-3 text-center font-mono text-stone-700">
                  <span class="font-bold text-emerald-800"><%= stat[:approved_count] %></span> / <%= stat[:capacity] %>명
                </td>
                <td class="p-3 text-center">
                  <span class="px-2 py-0.5 text-xs font-bold font-mono rounded <%= stat[:fill_rate] >= 80.0 ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-stone-100 text-stone-700 border border-stone-200' %>">
                    <%= stat[:fill_rate] %>%
                  </span>
                </td>
                <td class="p-3 text-right font-mono font-bold text-stone-900">
                  <%= number_to_currency(stat[:total_revenue], unit: "₩", precision: 0) %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="p-6 text-center text-stone-400 text-sm">통계를 출력할 강좌 데이터가 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>