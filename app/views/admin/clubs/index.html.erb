<% content_for :title, "시민 학습동아리 관리 및 보고서 검토" %>

<div class="w-full max-w-7xl mx-auto py-8 px-4 space-y-8">
  <!-- 상단 타이틀 영역 -->
  <div class="border-b border-stone-200 pb-5">
    <h1 class="text-3xl font-bold text-stone-900 tracking-tight">👥 시민 학습동아리 & 활동 보고서 관리</h1>
    <p class="text-stone-500 text-sm mt-1">시민 자율 학습동아리 신규 등록을 심사하고 제출된 월별 활동 보고서를 검토합니다.</p>
  </div>

  <!-- 신규 학습동아리 등록 승인 대기 목록 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200 flex justify-between items-center">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        신규 동아리 승인 대기
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-md border border-emerald-200">
        <%= @pending_clubs.count %>건 심사 중
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">동아리명</th>
            <th class="p-3">대표자</th>
            <th class="p-3">활동 소개</th>
            <th class="p-3">신청일</th>
            <th class="p-3 text-right">승인 심사</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @pending_clubs.any? %>
            <% @pending_clubs.each do |club| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-semibold text-stone-800"><%= club.name %></td>
                <td class="p-3 text-stone-700"><%= club.user.name %></td>
                <td class="p-3 text-stone-600"><%= club.description %></td>
                <td class="p-3 text-stone-400 text-xs"><%= club.created_at.strftime("%Y-%m-%d") %></td>
                <td class="p-3 text-right space-x-1">
                  <%= button_to "승인", approve_admin_club_path(club), method: :patch,
                      class: "px-3 py-1 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-lg transition inline-block"
                  %>
                  <%= button_to "반려", reject_admin_club_path(club), method: :patch,
                      class: "px-3 py-1 bg-stone-200 hover:bg-stone-300 text-stone-700 text-xs font-semibold rounded-lg transition inline-block"
                  %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="p-6 text-center text-stone-400 text-sm">승인 대기 중인 신규 동아리가 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 동아리 월별 활동 보고서 검토 대기 목록 -->
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-5 bg-stone-50 border-b border-stone-200 flex justify-between items-center">
      <h2 class="font-bold text-stone-800 text-lg flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        월별 활동 보고서 검토 대기
      </h2>
      <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-md border border-emerald-200">
        <%= @pending_reports.count %>건 제출됨
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-collapse">
        <thead>
          <tr class="bg-stone-50/50 text-stone-400 border-b border-stone-200 text-xs uppercase">
            <th class="p-3">동아리명</th>
            <th class="p-3">보고서 제목</th>
            <th class="p-3">활동 일자</th>
            <th class="p-3">활동 내용 요약</th>
            <th class="p-3 text-right">검토 확인</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% if @pending_reports.any? %>
            <% @pending_reports.each do |report| %>
              <tr class="hover:bg-stone-50 transition">
                <td class="p-3 font-semibold text-stone-800"><%= report.club.name %></td>
                <td class="p-3 font-semibold text-stone-700"><%= report.title %></td>
                <td class="p-3 font-mono text-stone-500 text-xs"><%= report.activity_date %></td>
                <td class="p-3 text-stone-600"><%= report.content %></td>
                <td class="p-3 text-right">
                  <%= button_to "검토 완료", review_report_admin_clubs_path(report_id: report.id), method: :patch,
                      class: "px-3 py-1 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-lg transition inline-block"
                  %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="p-6 text-center text-stone-400 text-sm">미검토 상태의 활동 보고서가 없습니다.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>