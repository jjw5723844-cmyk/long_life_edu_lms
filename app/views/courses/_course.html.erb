<div id="<%= dom_id course %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= course.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= course.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Instructor name:</strong>
    <%= course.instructor_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max students:</strong>
    <%= course.max_students %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Category:</strong>
    <%= course.category_id %>
  </div>
</div>
