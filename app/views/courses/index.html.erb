<% content_for :title, "전체 강좌 목록" %>

<!-- 상단 히어로 배너 -->
<div class="w-full bg-gradient-to-br from-emerald-800 via-emerald-900 to-stone-900 text-white py-16 px-6 shadow-inner">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <div>
      <span class="inline-block bg-emerald-700/40 text-emerald-200 text-xs font-bold px-3 py-1 rounded-full mb-3 tracking-wider">LIFELONG LMS</span>
      <h1 class="font-bold text-3xl md:text-4xl m-0 leading-snug">배움으로 채우는 일상,<br> 내일을 바꾸는 평생학습</h1>
      <p class="text-emerald-200/80 mt-2 text-base font-light">시민 누구에게나 열려 있는 고품격 맞춤형 교육 과정을 롱라이프에서 만나보세요.</p>
    </div>

    <% if current_user && (current_user.teacher? || current_user.admin?) %>
      <%= link_to "＋ 새 강좌 개설하기", new_course_path,
          class: "rounded-xl px-6 py-3.5 bg-white text-emerald-950 font-bold hover:bg-stone-100 shadow-md transition duration-200 inline-block" %>
    <% end %>
  </div>
</div>

<!-- 메인 컨텐츠 영역 -->
<div class="w-full max-w-6xl mx-auto py-12 px-6">

  <!-- 섹션 타이틀 헤더 -->
  <div class="mb-8 pb-4 border-b border-stone-200 flex justify-between items-center">
    <h2 class="font-bold text-2xl text-stone-900 m-0 flex items-center gap-2">
      <span class="text-emerald-700">■</span> 현재 모집 중인 강좌 안내
    </h2>
    <span class="text-sm text-stone-500">총 <strong class="text-emerald-700 font-bold"><%= @courses.count %></strong>개의 교육 과정</span>
  </div>

  <!-- Flash Notice 안내 메시지 -->
  <% if notice.present? %>
    <p class="px-4 py-3 bg-emerald-50 text-emerald-800 font-medium rounded-lg border border-emerald-200 inline-block mb-6" id="notice">✨ <%= notice %></p>
  <% end %>

  <!-- 강좌가 없을 경우 Empty State 표시 -->
  <% if @courses.empty? %>
    <div class="py-24 px-6 bg-white rounded-2xl border-2 border-dashed border-stone-200 text-center">
      <span class="text-5xl block mb-3">🎓</span>
      <p class="text-xl text-stone-500 font-medium m-0">현재 개설된 평생교육 강좌가 없습니다.</p>
      <% if current_user&.teacher? || current_user&.admin? %>
        <p class="text-stone-400 mt-2 text-sm">상단의 '새 강좌 개설하기' 버튼을 눌러 첫 번째 수업을 등록해 보세요!</p>
      <% else %>
        <p class="text-stone-400 mt-2 text-sm">새로운 강좌가 곧 개설될 예정이니 조금만 기다려주세요!</p>
      <% end %>
    </div>
  <% else %>
    
    <!-- 강좌 그리드 리스트 -->
    <div id="course" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @courses.each do |course| %>
        <%
          is_enrolled = current_user && course.registrations.exists?(user_id: current_user)
          is_full = course.registrations.count >= course.max_students
        %>

        <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-xl transition duration-300 group">
          <div>
            <!-- 강좌 썸네일 및 카테고리 태그 -->
            <div class="w-full h-48 overflow-hidden bg-stone-100 relative border-b border-stone-100">
              <% if course.image.attached? %>
                <%= image_tag course.image, class: "w-full h-full object-cover transition duration-500 group-hover:scale-105" %>
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center gap-2 text-stone-400">
                  <span class="text-3xl">🖼️</span>
                  <span class="text-xs">등록된 강좌 이미지가 없습니다</span>
                </div>
              <% end %>
              
              <span class="absolute top-3 left-3 bg-stone-900/85 text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-sm backdrop-blur-sm">
                <%= course.category&.name || "일반 분류" %> 
              </span>
            </div>

            <!-- 강좌 본문 정보 -->
            <div class="p-6">
              <!-- 접수 상태 배지 표시 -->
              <div class="mb-2">
                <% if is_enrolled %>
                  <span class="bg-emerald-50 text-emerald-700 text-xs font-bold px-2 py-0.5 rounded border border-emerald-200">수강 중</span>
                <% elsif is_full %>
                  <span class="bg-rose-50 text-rose-600 text-xs font-bold px-2 py-0.5 rounded border border-rose-200">정원 마감</span>
                <% else %>
                  <span class="bg-blue-50 text-blue-700 text-xs font-bold px-2 py-0.5 rounded border border-blue-200">접수 중</span>
                <% end %>
              </div>

              <h3 class="font-bold text-xl text-stone-900 mb-2 truncate group-hover:text-emerald-800 transition">
                <%= course.title %>
              </h3>
              
              <p class="text-stone-500 text-xs mb-3 flex items-center gap-1">
                <span>👨‍🏫</span> <strong>담당 강사:</strong> <%= course.instructor_name %> 선생님
              </p>
              
              <p class="text-stone-600 text-sm line-clamp-2 leading-relaxed min-h-[42px]">
                <%= course.description %>
              </p>
            </div>
          </div>

          <!-- 카드 하단 신청 현황 및 상세보기 버튼 -->
          <div class="p-6 pt-0">
            <div class="pt-4 border-t border-stone-100 flex justify-between items-center mb-4">
              <span class="text-sm text-stone-600">
                신청현황: <strong class="<%= is_full ? 'text-rose-600' : 'text-emerald-700' %> font-bold"><%= course.registrations.count %></strong> / <%= course.max_students %>명
              </span>
            </div>
            <%= link_to course_path(course), class: "block w-full py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-center rounded-xl transition duration-200" do %>
              <%= is_enrolled ? "강의실 입장 / 취소" : "강좌 상세보기 및 신청" %>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>
  <% end %>
</div>