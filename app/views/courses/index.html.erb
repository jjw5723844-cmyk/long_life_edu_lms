<% content_for :title, "전체 강좌 목록" %>
<div class="w-full max-w-6xl mx-auto py-8 px-4">

  <!-- 평생학습 강좌 소개 문구 디자인 -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-5 border-b border-stone-200">
    <div>
      <h1 class="font-bold text-3xl text-stone-900 tracking-tight">🏛️ 시민 평생학습 강좌 안내</h1>
      <p class="text-stone-500 mt-1 text-base">배움에는 나이가 없습니다. 원하는 강좌를 자유롭게 신청해 보세요.</p>
    </div>

    <!-- 강좌 개설의 디자인 및 개설 권한자 판단(강사인가? 관리자인가?) -->
    <% if current_user && (current_user.teacher? || current_user.admin?) %>
      <%= link_to "새 강좌 개설하기", new_course_path,
        class: "rounded-xl px-5 py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-base shadow-sm transition duration-200 block text-center" %>
    <% end %>
  </div>

  <% if notice.present? %>
    <p class="py-3 px-4 bg-green-50 mb-6 text-green-700 font-medium rounded-lg border border-green-200 inline-block text-lg" id="notice"><%= notice %></p>
  <% end %>

  <!-- 강좌가 개설되어있는지 판단되었을 경우와 강좌 개설 버튼 안내 -->
  <% if @courses.empty? %>
    <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-200 border-dashed">
      <p class="text-xl text-stone-500 font-medium">현재 개설된 평생교육 강좌가 없습니다.</p>

      <% if current_user&.instructor? %>
        <p class="text-stone-400 mt-2 text-sm">상단의 '새 강좌 개설하기' 버튼을 눌러 첫 번째 수업을 등록해 보세요!</p>
      <% else %>
        <p class="text-stone-400 mt-2">새로운 강좌가 곧 개설될 예정이니 조금만 기다려주세요!</p>
      <% end %>
    </div>
  <% else %>
    <div id="course" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @courses.each do |course| %>

      <!-- 비즈니스 로직 변수화(뷰 코드의 가독성 유지) -->
      <%
        is_enrolled = current_user && course.users.indclude?(current_user)
        is_full = course.registrations.count >= course.max_students
      %>

      <!-- 강좌 카테고리의 형식과 강좌 현황 명시 -->
      <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition duration-200 position-relative">
        <div>
          <div class="flex itmes-center justify-between mb-3">
            <span class="inline-block bg-stone-100 text-stone-700 text-xs font-semibold px-2.5 py-1 rounded-full">
              <%= course.category&.name || "일반 분류" %> 
            </span>

            <% if is_enrolled %>
              <span class="inline-block bg-emerald-50 text-emerald-700 text-xs font-bold px-2.5 py-1 rounded-md border border-emerald-200">
                수강 중
              </span>
            <% elseif is_full %>
              <span class="inline-block bg-red-50 text-red-600 text-xs font-bold px-2.5 py-1 rounded-md border border-red-200">
                마감
              </span>
            <% end %>
          </div>

          <h2 class="font-bold text-2xl text-stone-900 mb-2 truncate">
            <% course.title %>
          </h2>
          <!-- 강의할 강사 표기 -->
          <p class="text-stone-600 text-sm mb-4">
            <strong>담당 강사:</strong> <% course.instructor_name %> 선생님
          </p>
          <p class="text-stone-500 text-base line-clamp-2 mb-4 leading-relaxed">
            <%= course.description %>
          </p>
        </div>

        <!-- 수강 인원 현황 표시 -->
        <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between">
          <span class="text-base text-stone-600">
            신청: <strong class="<%= is_full ? 'text-red-600' : 'text-emerald-700' %> font-bold"><%= course.registrations.count %></strong>
            / <%= course.max_students %>명
          </span>

          <%=
            link_to is_enrolled ? "상세보기 / 취소" : "상세보기 및 신청", course,
            class: "rounded-lg px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-800 font-bold text-sm border border-stone-300 transition shrink-0"
          %>
        </div>
      </div>

      <% end %>
    </div>
  <% end %>
</div>
