<div class="course-form-container" style="max-width: 600px; margin: 40px auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; font-family: sans-serif;">
  
  <div style="margin-bottom: 25px; display: flex; gap: 15px; border-bottom: 1px solid #eee; padding-bottom: 15px;">
    <%= link_to "메인 홈으로", root_path, style: "color: #007bff; text-decoration: none; font-size: 14px; font-weight: bold;" %>
    
    <span style="color: #ccc;">|</span>
    
    <a href="javascript:history.back()" style="color: #6c757d; text-decoration: none; font-size: 14px; font-weight: bold;">이전 페이지로</a>
  </div>

  <h2 style="margin-bottom: 10px; color: #333;">🎓 새 강좌 개설하기</h2>
  <p style="color: #666; margin-bottom: 30px; font-size: 14px;">수강생들에게 제공할 멋진 강좌의 정보를 입력해 주세요.</p>

  <%= render "form", course: @course %>

</div>