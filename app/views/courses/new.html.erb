<% content_for :title, "새 강좌 개설" %>

<div class="max-w-2xl mx-auto my-10 p-8 bg-white border border-stone-200 rounded-2xl shadow-sm">
  
  <!-- 상단 네비게이션 링크 (홈으로 / 이전 페이지로) -->
  <div class="mb-6 flex items-center gap-4 border-b border-stone-200 pb-4">
    <%= link_to "메인 홈으로", root_path, class: "text-emerald-700 hover:text-emerald-800 text-sm font-bold transition" %>
    
    <span class="text-stone-300">|</span>
    
    <a href="javascript:history.back()" class="text-stone-500 hover:text-stone-800 text-sm font-bold transition">이전 페이지로</a>
  </div>

  <!-- 페이지 헤더 타이틀 -->
  <h2 class="text-2xl font-bold text-stone-900 mb-2.5 flex items-center gap-2">
    <span>🎓</span> 새 강좌 개설하기
  </h2>
  <p class="text-stone-500 mb-8 text-sm leading-relaxed">
    수강생들에게 제공할 멋진 강좌의 정보를 입력해 주세요.
  </p>

  <!-- 강좌 입력 폼 partial 렌더링 -->
  <%= render "form", course: @course %>

</div>