<% content_for :title, "강좌 상세 정보" %>
<div class="md:w-2/3 w-full mx-auto py-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-md inline-block text-lg" id="notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="py-3 px-4 bg-red-50 mb-5 text-red-700 font-medium rounded-lg border border-red-200 inline-block text-lg" id="alert"><%= alert %></p>
  <% end %>
  <div>
  </div>
</div>
