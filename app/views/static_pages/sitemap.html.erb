<% content_for :title, "사이트맵 - 롱 라이프 평생학습관" %>

<div class="min-h-screen bg-stone-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- 사이트 맵 헤더 영역 -->
    <div class="border-b border-stone-200 pb-5 mb-8">
      <h1 class="text-3xl font-bold text-stone-900">🗺️ 사이트맵</h1>
      <p class="mt-2 text-sm text-stone-600">롱라이프 평생학습관의 전체 메뉴 및 현재 개설된 교육 과정을 한눈에 확인하실 수 있습니다.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. 주요 메뉴 및 기관 안내 -->
      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm">
        <h2 class="text-lg font-bold text-stone-800 mb-4 pb-2 border-b border-stone-100 flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-emerald-600 rounded-full"></span>
          <span>주요 서비스 & 기관</span>
        </h2>
        <ul class="space-y-2.5 text-sm">
          <li>
            <%= link_to "🏢 기관소개", about_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "📢 공지사항", notices_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "📚 전체 강좌 목록", root_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "👨‍🏫 강사 소개", instructors_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
        </ul>
      </div>

      <!-- 2. 이용안내 및 시설 대관 -->
      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm">
        <h2 class="text-lg font-bold text-stone-800 mb-4 pb-2 border-b border-stone-100 flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-emerald-600 rounded-full"></span>
          <span class="shrink-0">이용안내 & 대관</span>
        </h2>
        <ul class="space-y-2.5 text-sm">
          <li>
            <%= link_to "📖 이용안내", guides_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "💳 수강신청 안내", registration_guides_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "🏢 시설 이용 안내", facility_guides_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "🏛️ 대관 시설 안내 & 신청", facilities_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
        </ul>
      </div>

      <!-- 3. 학습동아리 서비스 -->
      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm">
        <h2 class="text-lg font-bold text-stone-800 mb-4 pb-2 border-b border-stone-100 flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-emerald-600 rounded-full"></span>
          <span class="shrink-0">학습동아리</span>
        </h2>
        <ul class="space-y-2.5 text-sm">
          <li>
            <%= link_to "🌱 학습동아리 소개 & 모집", clubs_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "📝 신규 동아리 개설 신청", new_club_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
          <li>
            <%= link_to "📸 동아리 활동 갤러리", gallery_clubs_path,
                class: "text-stone-700 hover:text-emerald-700 font-medium transition"
            %>
          </li>
        </ul>
      </div>

      <!-- 4. 개설 교육 과정 동적 기능 수행 -->
      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm lg:col-span-2">
        <h2 class="text-lg font-bold text-stone-800 mb-4 pb-2 border-b border-stone-100 flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-emerald-600 rounded-full"></span>
          <span class="shrink-0">개설 교육 과정 목록</span>
        </h2>
        <!-- 캐싱 처리를 통한 동적 뷰 렌더링 메모리 점유 최소화 작업 -->
        <% cache ["sitemap_courses", @courses.maximum(:updated_at)] do %>
          <% if @courses.any? %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% @courses.each do |course| %>
                <div class="p-3.5 bg-stone-50 rounded-lg border border-stone-200 flex flex-col justify-between hover:border-emerald-300 transition">
                  <div>
                    <%= link_to course.title, course_path(course),
                        class: "text-sm font-bold text-stone-900 hover:text-emerald-700 transition block"
                    %>
                    <!-- Model에서 정의된 비즈니스 로직 메서드 사용 -->
                    <p class="text-xs text-stone-500 mt-1">담당 강사: <%= course.display_instructor_name %></p>
                  </div>
                  <div class="mt-3 flex items-center justify-between">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                      모집 중
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-stone-500 py-4">현재 개설되어 진행 중인 교육 과정이 없습니다.</p>
          <% end %>
        <% end %>
      </div>

      <!-- 5. 계정 서비스 및 시스템 지원 -->
      <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm">
        <h2 class="text-lg font-bold text-stone-800 mb-4 pb-2 border-b border-stone-100 flex items-center gap-2">
          <span class="w-2.5 h-2.5 bg-emerald-600 rounded-full"></span>
          <span class="shrink-0">이용자 계정 & 시스템</span>
        </h2>
        <ul class="space-y-2.5 text-sm">
          <% if current_user %>
            <% if current_user.admin? %>
              <li>
                <%= link_to "🛠️ 시스템 관리실", admin_dashboard_path,
                    class: "text-stone-700 hover:text-emerald-700 font-semibold transition"
                %>
              </li>
            <% elsif current_user.teacher? %>
              <li>
                <%= link_to "👨‍🏫 강사 대시보드", teacher_dashboard_path,
                    class: "text-stone-700 hover:text-emerald-700 font-semibold transition"
                %>
              </li>
            <% else %>
              <li>
                <%= link_to "🎒 나의 강의실", dashboard_path,
                    class: "text-stone-700 hover:text-emerald-700 font-semibold transition"
                %>
              </li>
            <% end %>
          <% else %>
            <li>
              <%= link_to "🔑 로그인", new_session_path,
                  class: "text-stone-700 hover:text-emerald-700 font-medium transition"
              %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>