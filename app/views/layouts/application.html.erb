<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "롱 라이프 평생교육 LMS" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-stone-50 text-stone-900 m-0 font-sans antialiased">
    <header class="w-full bg-white border-b border-stone-200 sticky top-0 z-50 shadow-sm block">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        
        <!-- 로고 및 사이트 이름 --> 
        <div class="logo">
          <%= link_to root_path,
              class: "flex items-center gap-2 text-xl font-bold text-emerald-800 tracking-tight hover:text-emerald-900 transition" do 
          %>
            <span>🏛️</span> 롱라이프 평생학습관
          <% end %>
        </div>

        <!-- 상단 메뉴 (기관소개, 공지사항, 교육과정, 이용안내) -->
        <nav class="flex items-center gap-6 text-sm font-medium">
          <%= link_to "🏢 기관소개", about_path, 
              class: "text-stone-700 hover:text-emerald-700 font-semibold transition"
          %>
          <%= link_to "📢 공지사항", notices_path, 
              class: "text-stone-700 hover:text-emerald-700 font-semibold transition"
          %>
        
          <!-- 교육 과정 드롭다운 -->
          <div class="relative group py-2">
            <button class="text-stone-700 hover:text-emerald-700 font-semibold flex items-center gap-1 bg-transparent border-0 cursor-pointer p-0 text-sm focus:outline-none">
              🎓 교육 과정 <span class="text-[10px] text-stone-400 group-hover:text-emerald-700 transition">▼</span>
            </button>

            <div class="absolute left-0 top-full w-36 pt-2 hidden group-hover:block z-50">
              <div class="bg-white border border-stone-200 rounded-xl shadow-lg py-1.5">
                <%= link_to "📚 강좌 목록", root_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs"
                %>
                <%= link_to "👨‍🏫 강사 소개", instructors_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs"
                %>
              </div>
            </div>
          </div>
          
          <!-- 이용안내 드롭다운 -->
          <div class="relative group py-2">
            <button class="text-stone-700 hover:text-emerald-700 font-semibold flex items-center gap-1 bg-transparent border-0 cursor-pointer p-0 text-sm focus:outline-none">
              📖 이용안내<span class="text-[10px] text-stone-400 group-hover:text-emerald-700 transition">▼</span>
            </button>

            <div class="absolute left-0 top-full w-40 pt-2 hidden group-hover:block z-50">
              <div class="bg-white border border-stone-200 rounded-xl shadow-lg py-1.5">
                <%= link_to "이용안내", guides_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs"
                %>
                <%= link_to "💳 수강신청 안내", registration_guides_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs"
                %>
                <%= link_to "🏢 시설 이용 안내", facility_guides_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs"
                %>
              </div>
            </div>
          </div>

          <span class="text-stone-300">|</span>
          
          <!-- 로그인 상태에 따른 사용자 메뉴 -->
          <% if current_user %>
            <% if current_user.admin? %>
              <%= link_to "🛠️ 시스템 관리실", admin_dashboard_path, class: "text-red-600 hover:text-red-800 font-bold tracking-tight transition" %>
            <% elsif current_user.teacher? %>
              <%= link_to "👨‍🏫 강사 대시보드", teacher_dashboard_path, class: "text-stone-700 hover:text-emerald-700 font-semibold transition" %>
            <% else %>
              <%= link_to "🎒 나의 강의실", dashboard_path, class: "text-stone-700 hover:text-emerald-700 font-semibold transition" %>
            <% end %>
            
            <span class="text-stone-300">|</span>
            
            <span class="text-stone-600 text-sm">
              🙋‍♂️ <strong class="text-stone-900 font-semibold"><%= current_user.name || current_user.email_address.split('@').first %></strong>님 로그인 중
            </span>

            <!-- 로그아웃 버튼 -->
            <%= button_to "로그아웃", session_path, method: :delete,
                class: "rounded-lg px-3 py-1.5 bg-stone-100 hover:bg-rose-50 text-stone-600 border border-stone-200 font-semibold text-xs transition cursor-pointer" %>
          <% else %>
            <!-- 로그인 버튼 -->
            <%= link_to "로그인", new_session_path,
                class: "rounded-lg px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs shadow-sm transition" %>
          <% end %>
        </nav>

      </div>
    </header>

    <% if flash[:notice] %>
      <div class="bg-emerald-100 text-emerald-800 p-3 text-center border-b border-emerald-200 text-sm font-medium">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="bg-rose-100 text-rose-800 p-3 text-center border-b border-rose-200 text-sm font-medium">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <!-- 본문 컨텐츠 영역 -->
    <main>
      <%= yield %>
    </main>

  </body>
</html>