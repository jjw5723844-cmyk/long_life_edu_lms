<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "롱 라이프 평생교육 LMS" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-stone-50 text-stone-900 m-0 font-sans antialiased">
    
    <header class="w-full bg-white border-b border-stone-200 sticky top-0 z-50 shadow-sm" style="display: block;">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between" style="display: flex; justify-content: space-between; align-items: center;">
        
        <div class="logo">
          <%= link_to root_path, class: "flex items-center gap-2 text-xl font-bold text-emerald-800 tracking-tight", style: "text-decoration: none; color: #065f46; font-weight: bold; font-size: 20px;" do %>
            <span>🏛️</span> 롱라이프 평생학습관
          <% end %>
        </div>

        <nav class="flex items-center gap-6 text-sm font-medium" style="display: flex; align-items: center; gap: 24px;">
          
          <% if current_user %>
            <% if current_user.admin? %>
              <%= link_to "🛠️ 시스템 관리실", admin_dashboard_path, class: "text-red-600 hover:text-red-800 font-bold tracking-tight", style: "text-decoration: none; color: #dc2626;" %>
            <% elsif current_user.teacher? %>
              <%= link_to "👨‍🏫 강사 대시보드", teacher_dashboard_path, class: "text-stone-700 hover:text-emerald-700 font-semibold", style: "text-decoration: none; color: #44403c;" %>
            <% else %>
              <%= link_to "🎒 나의 강의실", dashboard_path, class: "text-stone-700 hover:text-emerald-700 font-semibold", style: "text-decoration: none; color: #44403c;" %>
            <% end %>
            
            <span style="color: #d6d3d1;">|</span>
            
            <span class="text-stone-600" style="font-size: 14px; color: #57534e;">
              🙋‍♂️ <strong class="text-stone-900 font-semibold" style="color: #1c1917;"><%= current_user.name || current_user.email_address.split('@').first %></strong>님 로그인 중
            </span>

            <%= button_to "로그아웃", session_path, method: :delete,
              class: "rounded-lg px-3 py-1.5 bg-stone-100 hover:bg-rose-50 text-stone-600 border border-stone-200 font-semibold text-xs transition cursor-pointer",
              style: "background-color: #f5f5f4; color: #57534e; border: 1px solid #e7e5e4; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: bold;" %>
          
          <% else %>
            <%= link_to "로그인", new_session_path,
              class: "rounded-lg px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs shadow-sm transition",
              style: "color: white; text-decoration: none; background-color: #047857; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: bold;" %>
          <% end %>
        </nav>

      </div>
    </header>

    <% if flash[:notice] %>
      <div style="background-color: #d1fae5; color: #065f46; padding: 12px; text-align: center; border-bottom: 1px solid #a7f3d0; font-size: 14px;"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert] %>
      <div style="background-color: #ffe4e6; color: #9f1239; padding: 12px; text-align: center; border-bottom: 1px solid #fecdd3; font-size: 14px;"><%= flash[:alert] %></div>
    <% end %>

    <main>
      <%= yield %>
    </main>

  </body>
</html>
