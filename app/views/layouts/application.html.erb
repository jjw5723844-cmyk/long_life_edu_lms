<!DOCTYPE html>
<html>
  <head>
    <title>롱 라이프 평생교육 LMS</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin: 0 font-family: sans-serif background-color: #f8f9fa">
    <nav style="background-color: #212529 padding: 15px 30px display: flex justify-content: space-between align-items: center color: white">
      <div class="logo">
        <a href="<%= root_path %>" style="color: white text-decoration: none font-weight: bold font-size: 20px">🏛️ 시민 평생학습관</a>
      </div>

      <div class="nav-links" style="display: flex align-items: center gap: 20px">
        <% if current_user %>
        <span style="font-size: 14px color: #adb5bd">
          🙋‍♂️<strong><%= current_user.name || current_user.email_address.split('@').first %></strong>님 로그인 중
        </span>

        <!--로그아웃 및 로그인 디자인-->
          <%= button_to "로그아웃", session_path, method: :delete,
            style: "background-color: #dc3545 color: white border: none padding: 8px 16px border-radius: 4px,
            cursor: pointer font-size: 14px font-weight: bold" %>
        <% else %>
          <%= link_to "로그인", new_session_path,
              style: "color: white text-decoration: none background-color: #007bff padding: 8px 16px border-radius: 4px font-size: 14px font-weight: bold" %>
        <% end %>
      </div>
    </nav>

    <% if flash[:notice] %>
      <div style="background-color: #d4edda color: #155724 padding: 12px text-align: center border-bottom: 1px solid #c3e6cb"><%= flash[:notice] %></div>
    <% end %>

    <% if flash[:alert] %>
      <div style="background-color: #f8d7da; color: #721c24 padding: 12px text-align: center border-bottom: 1px solid #f5c6cb"><%= flash[:alert] %></div>
    <% end %>

    <!-- 학습자용 대시보드 링크 -->
    <% if current_user %>
      <%= 
        link_to "🎒 나의 강의실", dashboard_path, 
        class: "text-stone-700 hover:text-emerald-700 font-medium"
      %>
      <% else %>
      <% end %>

    <div class="container" style="padding: 20px">
      <%= yield %>
    </div>
  </body>
</html>
