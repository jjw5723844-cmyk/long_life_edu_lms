<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "롱 라이프 평생교육 LMS" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-stone-50 text-stone-900 m-0 font-sans antialiased">
    <header class="w-full bg-white border-b border-stone-200 sticky top-0 z-50 shadow-sm block">
      <%# [수정됨]: 드롭다운 메뉴 잘림 및 스크롤바 깜빡임 방지를 위해 overflow-hidden 제거 %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        
        <!-- 로고 및 사이트 이름 --> 
        <div class="logo shrink-0">
          <%= link_to root_path,
              class: "flex items-center gap-2 text-lg sm:text-xl font-bold text-emerald-800 tracking-tight hover:text-emerald-900 transition whitespace-nowrap" do 
          %>
            <span>🏛️</span> 롱라이프 평생학습관
          <% end %>
        </div>

        <!-- 상단 메뉴 (기관소개, 공지사항, 교육과정, 이용안내) -->
        <nav class="flex items-center gap-2.5 md:gap-4 lg:gap-5 text-xs sm:text-sm font-medium whitespace-nowrap">
          <%= link_to "🏢 기관소개", about_path, 
              class: "text-stone-700 hover:text-emerald-700 font-semibold transition shrink-0"
          %>
          <%= link_to "📢 공지사항", notices_path, 
              class: "text-stone-700 hover:text-emerald-700 font-semibold transition shrink-0"
          %>
        
          <!-- 교육 과정 드롭다운 -->
          <div class="relative group py-5 shrink-0">
            <button class="text-stone-700 hover:text-emerald-700 font-semibold flex items-center gap-1 bg-transparent border-0 cursor-pointer p-0 text-xs sm:text-sm focus:outline-none whitespace-nowrap">
              🎓 교육 과정 <span class="text-[10px] text-stone-400 group-hover:text-emerald-700 transition">▼</span>
            </button>

            <div class="absolute left-0 top-full w-36 pt-1 hidden group-hover:block z-50">
              <div class="bg-white border border-stone-200 rounded-xl shadow-lg py-1.5">
                <%= link_to "📚 강좌 목록", root_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
                <%= link_to "👨‍🏫 강사 소개", instructors_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
              </div>
            </div>
          </div>
          
          <!-- 이용안내 드롭다운 -->
          <div class="relative group py-5 shrink-0">
            <button class="text-stone-700 hover:text-emerald-700 font-semibold flex items-center gap-1 bg-transparent border-0 cursor-pointer p-0 text-xs sm:text-sm focus:outline-none whitespace-nowrap">
              📖 이용안내<span class="text-[10px] text-stone-400 group-hover:text-emerald-700 transition">▼</span>
            </button>

            <div class="absolute left-0 top-full w-45 pt-1 hidden group-hover:block z-50">
              <div class="bg-white border border-stone-200 rounded-xl shadow-lg py-1.5">
                <%= link_to "이용안내", guides_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
                <%= link_to "💳 수강신청 안내", registration_guides_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
                <%= link_to "🏢 시설 이용 안내", facility_guides_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>

                <div class="border-t border-stone-100 my-1"></div>
                <%= link_to "🏛️ 대관 시설 안내 & 신청", facilities_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
              </div>
            </div>
          </div>

          <!-- 학습동아리 드롭다운 -->
          <div class="relative group py-5 shrink-0">
            <button class="text-stone-700 hover:text-emerald-700 font-semibold flex items-center gap-1 bg-transparent border-0 cursor-pointer p-0 text-xs sm:text-sm focus:outline-none whitespace-nowrap">
              🤝 학습동아리<span class="text-[10px] text-stone-400 group-hover:text-emerald-700 transition">▼</span>
            </button>

            <div class="absolute left-0 top-full w-44 pt-1 hidden group-hover:block z-50">
              <div class="bg-white border border-stone-200 rounded-xl shadow-lg py-1.5">
                <%= link_to "🌱 학습동아리 소개 & 모집", clubs_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
                <%= link_to "📝 신규 동아리 개설 신청", new_club_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
                <%= link_to "📸 동아리 활동 갤러리", gallery_clubs_path,
                    class: "block px-4 py-2 text-stone-700 hover:bg-stone-50 hover:text-emerald-700 font-semibold transition text-xs whitespace-nowrap"
                %>
              </div>
            </div>
          </div>

          <span class="text-stone-300 shrink-0">|</span>

          <!-- 사이트맵 버튼 -->
          <%= link_to "🗺️ 사이트맵", sitemap_path,
              class: "rounded-lg px-2.5 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 hover:text-emerald-800 font-semibold text-xs border border-stone-200 transition shrink-0 whitespace-nowrap"
          %>
          
          <!-- 로그인 상태에 따른 사용자 메뉴 -->
          <% if current_user %>
            <% if current_user.admin? %>
              <%= link_to "🛠️ 시스템 관리실", admin_dashboard_path, class: "text-emerald-800 hover:text-emerald-900 font-bold tracking-tight transition shrink-0 whitespace-nowrap" %>
            <% elsif current_user.teacher? %>
              <%= link_to "👨‍🏫 강사 대시보드", teacher_dashboard_path, class: "text-stone-700 hover:text-emerald-700 font-semibold transition shrink-0 whitespace-nowrap" %>
            <% else %>
              <%= link_to "🎒 나의 강의실", dashboard_path, class: "text-stone-700 hover:text-emerald-700 font-semibold transition shrink-0 whitespace-nowrap" %>
            <% end %>
            
            <span class="text-stone-300 shrink-0">|</span>
            
            <span class="text-stone-600 text-xs sm:text-sm shrink-0 whitespace-nowrap">
              🙋‍♂️ <strong class="text-stone-900 font-semibold"><%= current_user.name || current_user.email_address.split('@').first %></strong>님 로그인 중
            </span>

            <!-- 로그아웃 버튼 -->
            <%= button_to "로그아웃", session_path, method: :delete,
                class: "rounded-lg px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-600 border border-stone-200 font-semibold text-xs transition cursor-pointer shrink-0 whitespace-nowrap" %>
          <% else %>
            <!-- 로그인 버튼 -->
            <%= link_to "로그인", new_session_path,
                class: "rounded-lg px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs shadow-sm transition shrink-0 whitespace-nowrap" %>
          <% end %>
        </nav>

      </div>
    </header>

    <% if flash[:notice] %>
      <div class="bg-emerald-100 text-emerald-800 p-3 text-center border-b border-emerald-200 text-sm font-medium">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="bg-stone-200 text-stone-800 p-3 text-center border-b border-stone-300 text-sm font-medium">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <!-- 본문 컨텐츠 영역 -->
    <main>
      <%= yield %>
    </main>

  </body>
</html>