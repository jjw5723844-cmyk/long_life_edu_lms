<% content_for :title, "강사 대시보드" %>

<div class="w-full max-w-6xl mx-auto py-8 px-4">

  <div class="mb-8 pb-5 border-b border-stone-200 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="font-bold text-3xl text-stone-900 tracking-tight">강사 대시보드</h1>
      <p class="text-stone-500 mt-1 text-base">
        <strong class="text-emerald-700 font-semibold"><%= current_user.name %></strong>
      </p>
    </div>
  </div>

  <% if @my_courses.empty? %>
    <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-200 border-dashed max-w-2xl mx-auto mt-10">
      <span class="text-5xl block mb-4">🏫</span>
      <p class="text-xl text-stone-600 font-semibold">개설한 강좌가 없습니다.</p>
      <p class="text-stone-400 mt-2 text-sm">등록된 강좌가 존재하지 않거나 강사님께서 개설한 강좌가 여기에 표시됩니다.</p>
    </div>

  <% else %>
    <div class="space-y-10">
      <% @my_courses.each do |course| %>
        <div class="bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden">

          <div class="bg-stone-50 p-6 border-b border-stone-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="bg-stone-200 text-stone-800 text-xs font-semibold px-2.5 py-0.5 rounded">
                  <%= course.category&.name || "일반 분류" %>
                </span>
                <span class ="text-xs text-stone-500">
                  개설일: <%= course.created_at.strftime("%Y-%m-%d") %>
                  </span>
              </div>
              <h2 class="font-bold text-xl text-stone-900"><%= course.title %></h2>
            </div>

            <div class="text-left sm:text-right">
              <span class="text-sm text-stone-600 block sm:inline">
                수강 인원: <strong class="text-emrald-700 font-bold"><%= course.registrations.count %></strong> / <%= course.max_students %>명
              </span>
            </div>
          </div>

          <div class="p-6">
            <h3 class="text-sm font-bold text-stone-700 mb-3 flex items-center gap-1.5">
              <span>수강생 명단</span>
              <span class="bg-emerald-50 text-emerald-700 text-xs px-2 py-0.5 rounded-full font-medium">총 <%= course.registrations.count %>명</span>
            </h3>

            <% if course.registrations.empty? %>
              <p class="text-stone-400 text-sm py-4 italic">현재 이 강좌를 신청한 수강생이 없습니다.</p>
            <% else %>
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm text-stone-600">
                  <thead>
                    <tr class="border-b border-stone-200 text-stone-400 font-medium bg-stone-50/50">
                      <th class="py-2 px-3 w-1/4">수강생 이름</th>
                      <th class="py-2 px-3 w-1/3">이메일</th>
                      <th class="py-2 px-3 text-right">수강 신청일</th>
                    </tr>
                  </thead>>
                  <tbody>
                    <% course.registrations.each do |registration| %>
                      <tr class="border-b border-stone-100 hover:bg-stone-50/50 transition">
                        <td class="py-3 px-3 font-semibold text-stone-800"><%= registration.user.name %></td>
                        <td class="py-3 px-3 text-stone-500"><%= registration.user.email_address %></td>
                        <td class="py-3 px-3 text-right text-stone-400"><%= registration.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>
  <% end %>
</div>