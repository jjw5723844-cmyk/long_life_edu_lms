<% content_for :title, "강사 소개" %>

<div class="w-full max-w-6xl mx-auto py-8 px-4">

  <div class="mb-10 pb-5 border-b border-stone-200">
    <h1 class="font-bold text-3xl text-stone-900 tracking-tight">👨‍🏫 강사 소개</h1>
    <p class="text-stone-500 mt-1 text-base">롱라이프 평생학습관에서 시민 여러분의 성장을 돕는 우수한 강사진을 소개합니다.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <% @teachers&.each do |teacher| %>
      <!-- 강사 계정과 연동 -->
      <div id="teacher-<%= teacher.id %>" class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition duration-200">
        <div>
          <div class="flex items-start gap-4 mb-4">
            <div class="w-14 h-14 rounded-full bg-stone-50 border border-stone-200 shadow-sm flex items-center justify-center text-2xl">
            </div>
            <!-- 강사 소개 페이지 및 관련 문구 -->
            <div>
              <h2 class="font-bold text-2xl text-stone-900 flex items-center gap-2">
                <%= teacher.name %> <span class="text-sm font-medium text-stone-400"> 선생님</span>
              </h2>
              <span class="inline-block mt-1 bg-emerald-50 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-md border border-emerald-200">
                전문 분야: <%= teacher.instructor_profile&.specialty || "일반 실용 교양" %>
              </span>
            </div>
          </div>

          <div class="bg-stone-50 rounded-xl p-4 mb-5 border border-stone-100">
            <p class="text-stone-600 text-sm whitespace-pre-line leading-relaxed">
              <%= teacher.instructor_profile&.bio  || "선생님의 상세 프로필 정보를 준비하고 있습니다." %>
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-stone-100">
          <span class="text-xs font-semibold text-stone-400 block mb-2 tracking-wider">👨‍💻 담당 개설 과정</span>
          <% if teacher.courses.any? %>
          <div class="flex flex-wrap gap-2">
            <% teacher.courses.each do |course| %>
              <%= link_to course.title, course,
                  class: "text-xs font-medium text-stone-700 bg-white border border-stone-200 hover:border-emerald-600 hover:text-emerald-700 px-3 py-1.5 rounded-lg shadow-sm transition"
              %>
            <% end %>
          </div>
        <% else %>
          <p class="text-xs text-stone-400 italic">현재 개설 준비 중인 교육 과정이 있습니다.</p>
        <% end %>
        </div>'
        
      </div>
      <% end %>
  </div>
</div>