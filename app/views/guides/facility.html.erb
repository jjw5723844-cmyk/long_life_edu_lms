<% content_for :title, "오프라인 시설 및 운영 안내" %>
<div class="w-full max-w-5xl mx-auto py-12 px-4">

  <!-- 오프라인 시설 이용안내 헤더 -->
  <div class="mb-10">
    <div class="flex items-center gap-2 text-xs text-stone-500 mb-3 font-medium">
      <%= link_to "이용안내 홈", guides_path,
          class: "hover:text-emerald-700 transition"
      %>
      <span class="text-stone-300">/</span>
      <span class="text-stone-800 font-semibold">오프라인 시설 및 운영 안내</span>
    </div>
    <h1 class="font-bold text-3xl text-stone-900 tracking-tight flex items-center gap-2">
      <span>🏢</span> 오프라인 시설 및 운영 가이드
    </h1>
    <p class="text-stone-500 mt-2 text-sm md:text-base leading-relaxed">
      롱라이프 평생학습관은 최신 디지털 교구와 쾌적한 학습 라운지를 갖추고 있습니다. 오프라인 학습관에 오셔서 여러분의 학습을 더욱 풍성하고 편리하게 이용해 주시길 바랍니다.
    </p>
  </div>

  <!-- 첫 번째 섹션: 기관 운영 시간 및 문의처 안내 -->
  <section class="mb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- 주중 운영시간 -->
      <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm text-center">
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2 py-1 rounded">Weekdays</span>
        <h3 class="font-bold text-base text-stone-900 mt-3">평일 운영시간</h3>
        <p class="text-xl font-extrabold text-stone-800 mt-1">09:00 ~ 21:00</p>
        <p class="text-[11px] text-stone-400 mt-1">야간 강좌 운영 포함</p>
      </div>

      <!-- 토요일 운영시간 및 휴관일 -->
      <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm text-center">
        <span class="text-xs font-bold text-stone-700 uppercase tracking-wider bg-stone-100 px-2 py-1 rounded">Saturday</span>
        <h3 class="font-bold text-base text-stone-900 mt-3">토요일 운영시간</h3>
        <p class="text-xl font-extrabold text-stone-800 mt-1">09:00 ~ 17:00</p>
        <p class="text-[11px] text-stone-400 mt-1">일요일 및 법정공휴일 휴관</p>
      </div>

      <!-- 학습관 종합 지원실 연락처 -->
      <div class="bg-emerald-800 border border-emerald-900 rounded-2xl p-5 shadow-sm text-center text-white">
        <span class="text-xs font-bold text-emerald-100 uppercase tracking-wider bg-emerald-700/50 px-2 py-1 rounded">Contact Us</span>
        <h3 class="font-bold text-base mt-3">학습관 종합 지원실</h3>
        <p class="text-xl font-extrabold mt-1">연락처: 032-1234-5678</p>
        <p class="text-[11px] text-emerald-200/80 mt-1">팩스: 032-1234-5678</p>
      </div>
    </div>
  </section>

  <!-- 두 번째 섹션: 학습관 층별 공간 안내 (드롭다운 선택 방식) -->
  <section class="mb-12">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-2 border-b border-stone-200">
      <h2 class="font-bold text-xl text-stone-950 m-0 flex items-center gap-2">
        <span class="text-emerald-700">01.</span> 학습관 층별 공간 안내
      </h2>

      <!-- 층 선택 드롭다운 박스 -->
      <div class="relative min-w-[280px]">
        <select id="floor-select" 
            class="w-full px-4 py-2.5 bg-white border-2 border-emerald-600 rounded-xl text-sm font-bold text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-700 shadow-sm cursor-pointer transition">
          <option value="1" selected>🏢 1F : 종합 지원실 & 튼튼 북카페</option>
          <option value="2">📚 2F : 다목적 강의실 & 도서 정보실</option>
          <option value="3">💻 3F : 스마트 정보화 배움터</option>
        </select>
      </div>
    </div>

    <!-- 선택된 층별 도면 및 상세 정보 카드 컨테이너 -->
    <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm space-y-6">
      <!-- 도면 이미지 출력 영역 -->
      <div class="bg-stone-50 border border-stone-200 rounded-xl p-4 flex items-center justify-center min-h-[280px] overflow-hidden">
        <%= image_tag "long_life_1f.png", id: "floor-plan-img", alt: "1층 공간 도면", class: "w-full h-auto max-w-4xl rounded-lg object-contain" %>
      </div>

      <!-- 층별 텍스트 설명 영역 -->
      <div class="space-y-3 pt-2">
        <h3 id="floor-plan-title" class="font-bold text-xl text-stone-900">
          1F : 학습관 종합 지원실 & 튼튼 북카페 라운지
        </h3>
        <p id="floor-plan-desc" class="text-sm text-stone-600 leading-relaxed">
          현장 수강증 발급, 교육 상담 및 차량 번호 정기 등록 등 전반적인 학습자를 지원하기 위한 행정 허브 공간이며, 개방형 튼튼 북카페 라운지를 지역주민과 학습자가 자유롭게 이용할 수 있도록 운영됩니다.
        </p>
        <div id="floor-plan-tags" class="flex flex-wrap gap-1.5 pt-3 border-t border-stone-100">
          <span class="px-3 py-1 bg-stone-100 border border-stone-200 text-stone-700 text-xs rounded-lg font-semibold">💼 학습관 종합 지원실</span>
          <span class="px-3 py-1 bg-stone-100 border border-stone-200 text-stone-700 text-xs rounded-lg font-semibold">☕ 튼튼 북카페(개방형)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 세 번째 섹션: 주차 및 교통편 안내 -->
  <section class="mb-12">
    <h2 class="font-bold text-xl text-stone-950 mb-6 flex items-center gap-2 pb-2 border-b border-stone-200">
      <span class="text-emerald-700">02.</span> 주차 및 교통편 안내
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- 주차 정보 -->
      <div class="bg-stone-100/60 border border-stone-200/80 rounded-2xl p-5">
        <h3 class="font-bold text-base text-stone-900 flex items-center gap-1.5 mb-3">
          🚗 주차장 이용 수칙
        </h3>
        <ul class="text-xs space-y-2.5 text-stone-600 leading-relaxed">
          <li class="flex items-start gap-1">
            <span class="text-emerald-700 font-bold">✓</span>
            <span>수강생에 한해 최초 2시간 무료 주차권을 제공합니다.</span>
          </li>
          <li class="flex items-start gap-1">
            <span class="text-emerald-700 font-bold">✓</span>
            <span>주차권을 제공 받으려면 주차 후 반드시 1층 학습관 종합 지원실 행정 패드에 차량 번호 4자리를 전산 등록하셔야 합니다.</span>
          </li>
          <li class="flex items-start gap-1">
            <span class="text-stone-400">※</span>
            <span>무료 주차시간 2시간 이후 초과 30분당 1,500원의 일반 추가 요금이 부과됩니다.</span>
          </li>
        </ul>
      </div>

      <!-- 대중교통 안내 -->
      <div class="bg-stone-100/60 border border-stone-200/80 rounded-2xl p-5">
        <h3 class="font-bold text-base text-stone-900 flex items-center gap-1.5 mb-3">
          🗺️ 대중교통 안내
        </h3>
        <ul class="text-xs space-y-2.5 text-stone-600 leading-relaxed">
          <li class="flex items-start gap-2">
            <span class="bg-emerald-800 text-white font-extrabold text-[10px] px-3 py-3 whitespace-nowrap rounded">🚇 지하철</span>
            <span>시청역 4번 출구에서 도보 5분 거리(직진 300m 후 신호등을 건너고 좌회전)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="bg-emerald-700 text-white font-extrabold text-[10px] px-3 py-3 whitespace-nowrap rounded">🚌 시내버스</span>
            <span>롱라이프 평생학습관 정류장 정차 버스(지선 7712번, 간선 270번, 순환 01번)</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 네 번째 섹션: 학습관 기자재 이용 규칙 -->
  <section class="mb-12">
    <h2 class="font-bold text-xl text-stone-950 mb-4 flex items-center gap-2 pb-2 border-b border-stone-200">
      <span class="text-emerald-700">03.</span> 기자재 이용 및 안전 규칙
    </h2>

    <div class="bg-stone-100 border border-stone-200 rounded-2xl p-6">
      <div class="flex items-start gap-3">
        <span class="text-2xl">⚠️</span>
        <div>
          <h3 class="font-bold text-sm md:text-base text-stone-900">학습관 공용 기자재 이용 사항</h3>
          <p class="text-xs text-stone-600 mt-1 leading-relaxed">
            가상환경 실습 시에 비치된 AR, VR기기 등의 기자재는 외부 무단 반출이 불가하며, 오직 학습관 내부 실습을 목적으로만 사용 가능합니다. 고장이나 파손 예방을 위해 반드시 강사 지도하에 전원을 작동하고 점검에 협조해주시기를 바랍니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 하단 버튼 영역 -->
  <div class="pt-6 border-t border-stone-200 flex flex-col sm:flex-row gap-4 justify-between items-center">
    <%= link_to guides_path,
        class: "inline-flex items-center text-xs font-semibold text-stone-600 hover:text-stone-900 transition gap-1.5" do
    %>
      <span>←</span> 이용안내 목록으로 가기
    <% end %>
    <%= link_to root_path,
        class: "w-full sm:w-auto text-center px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-xl shadow-sm transition" do
    %>
      강좌 목록 보러가기 📚
    <% end %>
  </div>

</div>

<!-- 층별 버튼 클릭시 드롭박스되어 이미지와 함께 층별 소개 문구 표기-->
<script>
  (function() {
    const floorData = {
      "1": {
        title: "1F : 학습관 종합 지원실 & 튼튼 북카페 라운지",
        desc: "현장 수강증 발급, 교육 상담 및 차량 번호 정기 등록 등 전반적인 학습자를 지원하기 위한 행정 허브 공간이며, 개방형 튼튼 북카페 라운지를 지역주민과 학습자가 자유롭게 이용할 수 있도록 운영됩니다.",
        tags: ["💼 학습관 종합 지원실", "☕ 튼튼 북카페(개방형)"],
        img: "<%= image_path('long_life_1f.png') %>"
      },
      "2": {
        title: "2F : 다목적 강의실 & 도서 정보실/열람실 & 세미나실",
        desc: "인문 교양 강좌, 취미, 자격증 교육 등 평생학습 강의가 이루어지는 다목적 교육공간으로, 도서 정보실/열람실 및 세미나실을 갖추고 있습니다.",
        tags: ["🎨 다목적 강의실 (A/B/C)", "📖 도서 정보실/열람실", "👥 다목적 세미나실"],
        img: "<%= image_path('long_life_2f.png') %>"
      },
      "3": {
        title: "3F : 스마트 정보화 배움터 & 가상환경 실습실",
        desc: "최신 PC 멀티미디어 강의실(데스크톱 30대)과 VR 가상환경 실습실 1·2(VR 기기 각 10대) 및 스마트 기기 체험 존으로 구성된 스마트 정보화 배움터입니다.",
        tags: ["💻 멀티미디어 교실", "🥽 가상환경 실습실"],
        img: "<%= image_path('long_life_3f.png') %>"
      }
    };

    function setupFloorDropdown() {
      const selectEl = document.getElementById("floor-select");
      const imgEl = document.getElementById("floor-plan-img");
      const titleEl = document.getElementById("floor-plan-title");
      const descEl = document.getElementById("floor-plan-desc");
      const tagsEl = document.getElementById("floor-plan-tags");

      if (!selectEl) return;

      selectEl.addEventListener("change", function() {
        const selectedValue = this.value;
        const data = floorData[selectedValue];
        if (!data) return;

        if (imgEl) {
          imgEl.src = data.img;
          imgEl.alt = `${selectedValue}층 공간 도면`;
        }
        if (titleEl) titleEl.textContent = data.title;
        if (descEl) descEl.textContent = data.desc;
        if (tagsEl) {
          tagsEl.innerHTML = data.tags.map(tag => 
            `<span class="px-3 py-1 bg-stone-100 border border-stone-200 text-stone-700 text-xs rounded-lg font-semibold">${tag}</span>`
          ).join('');
        }
      });
    }

    document.addEventListener("DOMContentLoaded", setupFloorDropdown);
    document.addEventListener("turbo:load", setupFloorDropdown);
  })();
</script>