<% content_for :title, "오프라인 시설 및 운영 안내" %>
<div class="w-full max-w-4xl mx-auto py-12 px-4">

  <!-- 오프라인 시설 이용안내 헤더 -->
  <div class="mb-10">
    <div class="flex items-center gap-2 text-xs text-stone-500 mb-3 font-medium">
      <%= link_to "이용안내 홈", guides_path,
          class: "hover:text-emerald-700 transition"
      %>
      <span class="text-stone-300">/</span>
      <span class="text-stone-800 font-semibold">오프라인 시설 및 운영 안내</span>
    </div>
    <h1 class="font-bold text-3xl text-stone-900 tracking-tight flex items-center gap-2">
      <span>🏢</span> 오프라인 시설 및 운영 가이드
    </h1>
    <p class="text-stone-500 mt-2 text-sm md:text-base leading-relaxed">
      롱라이프 평생학습관은 최신 디지털 교구와 괘적한 학습 라운지를 갖추고 있습니다. 오프라인 학습관에 오셔서 여러분의 학습을 더욱 풍성하고 편리하게 이용해 주시길 바랍니다.
    </p>
  </div>

  <!-- 첫 번째 섹션: 기관 운영 시간 및 문의처 안내 -->
  <section class="mb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- 주중 운영시간 -->
      <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm text-center">
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2 py-1 rounded">Weekdays</span>
        <h3 class="font-bold text-base text-stone-900 mt-3">평일 운영시간</h3>
        <p class="text-xl font-extrabold text-stone-800 mt-1">09:00 ~ 21:00</p>
        <p class="text-[11px] text-stone-400 mt-1">야간 강좌 운영 포함</p>
      </div>

      <!-- 토요일 운영시간 및 휴관일 -->
      <div class="bg-white border border-stone-200 rounded-2xl p-5 shadow-sm text-center">
        <span class="text-xs font-bold text-amber-700 uppercase tracking-wider bg-amber-50 px-2 py-1 rounded">Saturday</span>
        <h3 class="font-bold text-base text-stone-900 mt-3">토요일 운영시간</h3>
        <p class="text-xl font-extrabold text-stone-800 mt-1">09:00 ~ 17:00</p>
        <p class="text-[11px] text-stone-400 mt-1">일요일 및 법정공휴일 휴관</p>
      </div>

      <!-- 학습관 종합 지원실 연락처 -->
      <div class="bg-emerald-800 border border-emerald-900 rounded-2xl p-5 shadow-sm text-center text-white">
        <span class="text-xs font-bold text-emerald-100 uppercase tracking-wider bg-emerald-700/50 px-2 py-1 rounded">Contact Us</span>
        <h3 class="font-bold text-base mt-3">학습관 종합 지원실</h3>
        <p class="text-xl font-extrabold mt-1">연락처: 032-1234-5678</p>
        <p class="text-[11px] text-emerald-200/80 mt-1">팩스: 032-1234-5678</p>
      </div>
    </div>
  </section>

  <!-- 두 번째 섹션: 학습관 층별 안내 -->
  <section class="mb-12">
    <h2 class="font-bold text-xl text-stone-950 mb-6 flex items-center gap-2 pb-2 border-b border-stone-200">
      <span class="text-emerald-700">01.</span> 학습관 층별 공간 안내
    </h2>

    <div class="space-y-4">

      <!-- 3층 안내 -->
      <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm flex flex-col md:flex-row gap-4 items-start">
        <div class="w-12 h-12 rounded-xl bg-stone-100 border border-stone-200 flex items-center justify-center text-lg font-black text-stone-700 shrink-0">
          3F
        </div>
        <div>
          <h3 class="font-bold text-base text-stone-900">스마트 정보화 배움터 & 가상환경 실습실</h3>
          <p>
            컴퓨터, 스마트기기 활용 교육 및 AR, VR 기기를 통한 가상환경 실습이 이루어지는 공간입니다. 최신 디지털 데스크톱 30대가 구비되어있는 1개의 강의실과 10개의 VR기기가 구비되어있는 2개의 실습실로 구성되어 있습니다.
          </p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            <span class="px-2 py-0.5 bg-stone-50 border border-stone-200 text-stone-500 text-[10px] rounded">💻 멀티미디어 교실</span>
            <span class="px-2 py-0.5 bg-stone-50 border border-stone-200 text-stone-500 text-[10px] rounded">🥽 가상환경 실습실</span>
          </div>
        </div>
      </div>

      <!-- 2층 안내 -->
      
    </div>
  </section>
</div>