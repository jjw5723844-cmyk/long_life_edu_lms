<!-- 공지사학 작성 및 수정을 위한 공통 폼 파셜 컴포넌트 구성 -->
<%= form_with(model: notice, local: true, class: "space-y-6") do |f| %>
  <!-- 유효성 검증 실패 시 오류 메시지 출력 -->
  <% if notice.errors.any? %>
    <div class="p-4 bg-stone-100 border border-stone-300 rounded-xl text-stone-800 text-xs space-y-1">
      <p class="font-bold text-emerald-800">⚠️ 입력 내용을 확인해 주세요 (<%= notice.errors.count %>개의 오류):</p>
      <ul class="list-disc list-inside space-y-0.5 text-stone-600">
        <% notice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 싱단 고정 중요 공지 체크박스 -->
  <div class="flex items-center gap-2 p-3.5 bg-stone-50 border border-stone-200 rounded-xl">
    <%= f.check_box :is_pinned,
        class: "w-4 h-4 text-emerald-700 bg-white border-stone-300 rounded focus:ring-emerald-600 cursor-pointer"
    %>
    <%= f.label :is_pinned, "📌 상단 고정 (중요 공지사항으로 등록)", class: "text-xs font-bold text-stone-800 cursor-pointer" %>
  </div>

  <!-- 공지사항 제목 입력 필드 -->
  <div>
    <%= f.label :title, "공지 제목", class: "block text-xs font-bold text-stone-700 mb-1.5" %>
    <%= f.text_field :title, placeholder: "공지사항 제목을 입력해 주세요.",
        class: "w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition"
    %>
  </div>

  <!-- 공지사항 내용 입력 필드 -->
  <div>
    <%= f.label :content, "공지 내용", class: "block text-xs font-bold text-stone-700 mb-1.5" %>
    <%= f.text_area :content, rows: 12, placeholder: "공지사항 상세 내용을 작성해 주세요.",
        class: "w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-xl text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition leading-relaxed"
    %>
  </div>

  <!-- 저장 및 취소 버튼 -->
  <div class="pt-4 border-t border-stone-100 flex items-center justify-end gap-3">
    <%= link_to "취소", notices_path,
        class: "px-5 py-2.5 bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold text-xs rounded-xl transition"
    %>
    <%= f.submit (notice.persisted? ? "수정 완료" : "공지사항 등록"),
        class: "px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-xl shadow-sm transition cursor-pointer"
    %>
  </div>
<% end %>