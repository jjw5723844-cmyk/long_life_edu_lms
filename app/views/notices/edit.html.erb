<% content_for :title, "공지사항 수정" %>

<div class="w-full bg-stone-100 border-b border-stone-200 py-10 px-6">
  <div class="max-w-3xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="font-bold text-2xl text-stone-900 m-0">✏️ 공지사항 수정</h1>
      <p class="text-stone-500 text-sm mt-1.5">록된 공지사항 정보 및 상세 내용을 수정합니다.</p>
    </div>
    <%= link_to notice_path(@notice), class: "inline-flex items-center gap-1.5 text-stone-600 hover:text-stone-900 font-medium text-xs transition" do %>
    ← 상세보기로 돌아가기
    <% end %>
  </div>
</div>

<div class="max-w-3xl mx-auto py-10 px-6">
  <div class="bg-white border border-stone-200 rounded-2xl p-6 sm:p-8 shadow-sm">
    <%= render "form", notice: @notice %>
  </div>
</div>