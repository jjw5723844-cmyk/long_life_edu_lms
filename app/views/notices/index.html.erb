<% content_for :title, "공지사항" %>

<!-- 상단 타이틀 헤더 바 -->
<div class="w-full bg-stone-100 border-b border-stone-200 py-10 px-6">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="font-bold text-2xl text-stone-900 m-0">📢 공지사항</h1>
      <p class="text-stone-500 text-sm mt-1.5">롱라이프 평생학습관의 주요 소식과 안내 사항을 전해드립니다.</p>
    </div>

    <!-- 관리자 전용 공지사항 작성 버튼 -->
    <% if respond_to?(:current_user) && current_user&.respond_to?(:admin?) && current_user.admin? %>
      <div>
        <%= link_to new_notice_path, 
            class: "inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-xl shadow-sm transition" do
        %>
          <span>✏️</span> 공지사항 작성
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- 메인 공지사항 게시판 컨테이너 -->
<div class="max-w-6xl mx-auto py-10 px-6 space-y-6">

  <!-- 카테고리 필터 & 검색 바 -->
  <div class="bg-white border border-stone-200 rounded-xl p-4 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0 scrollbar-none">
      <% 
        current_cat = params[:category].presence || "전체"
        categories = ["전체", "모집안내", "행사/소식", "시설/대관"]
      %>
      <% categories.each do |cat| %>
        <% is_active = (current_cat == cat) %>
        <%= link_to cat, notices_path(category: (cat == "전체" ? nil : cat), query: params[:query]),
            class: "px-3.5 py-1.5 font-bold text-xs rounded-lg transition whitespace-nowrap #{is_active ? 'bg-stone-900 text-white shadow-sm' : 'bg-stone-100 hover:bg-stone-200 text-stone-700 font-medium'}"
        %>
      <% end %>
    </div>

    <!-- 검색 입력창 -->
    <div class="w-full sm:w-72">
      <%= form_with url: notices_path, method: :get, class: "relative flex items-center" do |f| %>
        <% if params[:category].present? %>
          <%= f.hidden_field :category, value: params[:category] %>
        <% end %>
        <%= f.text_field :query, value: params[:query], placeholder: "제목 또는 내용 검색...",
            class: "w-full pl-3.5 pr-9 py-2 bg-stone-50 border border-stone-200 rounded-lg text-xs text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition"
        %>
        <button type="submit" class="absolute right-3 text-stone-400 hover:text-emerald-700 transition" aria-label="검색">
          🔍
        </button>
      <% end %>
    </div>
  </div>
  
  <!-- 공지사항 테이블 카드 박스  -->
  <div class="bg-white rounded-xl border border-stone-200 overflow-hidden shadow-sm">
    
    <!-- 총 게시물 수 안내 헤더 바 -->
    <div class="px-5 py-3 bg-stone-50 border-b border-stone-100 flex items-center justify-between text-xs text-stone-500">
      <span>총 <strong class="text-emerald-700 font-bold"><%= @notices.size %></strong>건의 공지사항이 등록되어 있습니다.</span>
      <span class="hidden sm:inline">최신 등록순</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        
        <!-- 공지사항 테이블 헤더 -->
        <thead>
          <tr class="bg-stone-50/80 border-b border-stone-200 text-stone-600 font-semibold text-xs">
            <th class="py-3.5 px-5 w-20 text-center">번호</th>
            <th class="py-3.5 px-5">제목</th>
            <th class="py-3.5 px-5 w-36 text-center">작성일</th>
            <th class="py-3.5 px-5 w-24 text-center">조회</th>
          </tr>
        </thead>

        <!-- 공지사항 본문 리스트 -->
        <tbody class="text-stone-800 divide-y divide-stone-100">
          <!-- 등록된 공지사항이 없을 때 예외 처리 -->
          <% if @notices.empty? %>
            <tr>
              <td colspan="4" class="py-16 text-center text-stone-400 text-sm">
                <span class="text-3xl block mb-2">📢</span>
                등록된 공지사항이 없습니다.
              </td>
            </tr>
          <% else %>
            <% @notices.each_with_index do |notice, index| %>
              <tr class="hover:bg-stone-50/80 transition-colors <%= 'bg-emerald-50/60' if notice.is_pinned %>">
                <!-- 번호 / [중요] 표시 -->
                <td class="py-4 px-5 text-center <%= notice.is_pinned ? 'text-emerald-700 font-bold' : 'text-stone-400 text-xs' %>">
                  <%= notice.is_pinned ? "[중요]" : (@notices.size - index) %>
                </td>
          
                <!-- 게시글 제목 및 필독 배지 -->
                <td class="py-4 px-5 <%= 'font-semibold' if notice.is_pinned %>">
                  <% if notice.is_pinned %>
                    <span class="inline-block bg-emerald-100 text-emerald-800 text-[11px] font-bold px-1.5 py-0.5 rounded mr-1.5">필독</span>
                  <% end %>
                  <%= link_to notice.title, notice_path(notice),
                      class: "text-stone-900 hover:text-emerald-800 transition-colors font-medium"
                  %>
                </td>
          
                <!-- 작성일 -->
                <td class="py-4 px-5 text-center text-stone-500 font-mono text-xs sm:text-sm">
                  <%= notice.created_at.strftime("%Y-%m-%d") %>
                </td>
          
                <!-- 조회수 -->
                <td class="py-4 px-5 text-center text-stone-500 font-mono text-xs sm:text-sm">
                  <%= number_with_delimiter(notice.view_count) %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- 하단 페이지네이션 영역 -->
    <div class="px-5 py-3.5 bg-stone-50/50 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
      <span>1 / 1 페이지</span>
      <div class="inline-flex items-center space-x-1">
        <button type="button" class="px-3 py-1.5 rounded-lg border border-stone-200 bg-white text-stone-400 text-xs font-bold disabled:opacity-50" disabled>이전</button>
        <button type="button" class="px-3 py-1.5 rounded-lg bg-emerald-700 text-white font-bold text-xs shadow-sm">1</button>
        <button type="button" class="px-3 py-1.5 rounded-lg border border-stone-200 bg-white text-stone-700 text-xs font-bold hover:bg-stone-50 transition">다음</button>
      </div>
    </div>

  </div>

</div>