<% content_for :title, "공지사항" %>

<div class="w-full bg-stone-100 border-b border-stone-200 py-10 px-6" style="background-color: #f5f5f4 border-bottom: 1px solid #e7e5e4 padding: 40px 24px">
  <div class="max-w-6xl mx-auto" style="max-width: 1152px margin: 0 auto">
    <h1 style="font-weight: bold font-size: 26px color: #1c1917 margin: 0">📢 공지사항</h1>
    <p style="color: #78716c font-size: 14px margin: 6px 0 0 0">롱라이프 평생학습관의 주요 소식과 안내 사항을 전해드립니다.</p>
  </div>
</div>

<div class="max-w-6xl mx-auto py-12 px-6" style="max-width: 1152px margin: 0 auto padding: 48px 24px">
  
  <div style="background-color: white border-radius: 12px border: 1px solid #e7e5e4 overflow: hidden box-shadow: 0 1px 2px rgba(0,0,0,0.02)">
    <table style="width: 100% border-collapse: collapse text-align: left font-size: 14px">
      
      <!-- 공지사항 테이블 세터 -->
      <thead>
        <tr style="background-color: #fafaf9 border-bottom: 1px solid #e7e5e4 color: #57534e font-weight: 600">
          <th style="padding: 16px 20px width: 80px text-align: center">번호</th>
          <th style="padding: 16px 20px">제목</th>
          <th style="padding: 16px 20px width: 14px width: 140px text-align: center">작성일</th>
          <th style="padding: 16px 20px width: 90px text-align: center">조회</th>
        </tr>
      </thead>

      <tbody style="color: #292524">
        <% @notices.each_with_index do |notice, index| %>
          <tr style="border-bottom: 1px solid #f5f5f4 <%= 'background-color: #fefce8' if notice.is_pinned %>" class="hover:bg-stone-50/50">
            <td style="padding: 16px 20px text-align: center <%= notice.is_pinned ? 'color: #b45309 font-weight: bold' : 'color: #a8a29e' %>">
              <%= notice.is_pinned ? "[중요]" : (@notices.size - index) %>
            </td>
      
            <td style="padding: 16px 20px <%='font-weight: 600' if notice.is_pinned %>">
              <% if notice.is_pinned %>
                <span style="background-color: #fef3c7 color: #92400e font-size: 11px padding: 2px 6px border-radius: 4px margin-right: 6px">필독</span>
              <% end %>
              <%= link_to notice.title, notice_path(notice), style: "color: #1c1917 text-decoration: none", class: "hover:text-emerald-700" %>
            </td>
      
      <td style="padding: 16px 20px text-align: center color: #78716c">
        <%= notice.created_at.strftime("%Y-%m-%d") %>
      </td>
      
      <td style="padding: 16px 20px text-align: center color: #78716c">
        <%= number_with_delimiter(notice.view_count) %>
      </td>
      
    </tr>
  <% end %>
</tbody>
    </table>
  </div>

</div>