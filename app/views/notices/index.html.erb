<% content_for :title, "공지사항" %>

<!-- 상단 타이틀 헤더 바 -->
<div class="w-full bg-stone-100 border-b border-stone-200 py-10 px-6">
  <div class="max-w-6xl mx-auto">
    <h1 class="font-bold text-2xl text-stone-900 m-0">📢 공지사항</h1>
    <p class="text-stone-500 text-sm mt-1.5">롱라이프 평생학습관의 주요 소식과 안내 사항을 전해드립니다.</p>
  </div>
</div>

<!-- 메인 공지사항 게시판 컨테이너 -->
<div class="max-w-6xl mx-auto py-12 px-6">
  
  <!-- 공지사항 테이블 카드 박스  -->
  <div class="bg-white rounded-xl border border-stone-200 overflow-hidden shadow-sm overflow-x-auto">
    <table class="w-full border-collapse text-left text-sm">
      
      <!-- 공지사항 테이블 헤더 -->
      <thead>
        <tr class="bg-stone-50 border-b border-stone-200 text-stone-600 font-semibold">
          <th class="py-4 px-5 w-20 text-center">번호</th>
          <th class="py-4 px-5">제목</th>
          <th class="py-4 px-5 w-36 text-center">작성일</th>
          <th class="py-4 px-5 w-24 text-center">조회</th>
        </tr>
      </thead>

      <!-- 공지사항 본문 리스트 -->
      <tbody class="text-stone-800 divide-y divide-stone-100">
        <% @notices.each_with_index do |notice, index| %>
          <tr class="hover:bg-stone-50/80 transition-colors <%= 'bg-amber-50/70' if notice.is_pinned %>">
            
            <!-- 번호 / [중요] 표시 -->
            <td class="py-4 px-5 text-center <%= notice.is_pinned ? 'text-amber-700 font-bold' : 'text-stone-400' %>">
              <%= notice.is_pinned ? "[중요]" : (@notices.size - index) %>
            </td>
      
            <!-- 게시글 제목 및 필독 배지 -->
            <td class="py-4 px-5 <%= 'font-semibold' if notice.is_pinned %>">
              <% if notice.is_pinned %>
                <span class="inline-block bg-amber-100 text-amber-800 text-[11px] font-bold px-1.5 py-0.5 rounded mr-1.5">필독</span>
              <% end %>
              <%= link_to notice.title, notice_path(notice), class: "text-stone-900 hover:text-emerald-800 transition-colors font-medium" %>
            </td>
      
            <!-- 작성일 -->
            <td class="py-4 px-5 text-center text-stone-500 font-mono text-xs sm:text-sm">
              <%= notice.created_at.strftime("%Y-%m-%d") %>
            </td>
      
            <!-- 조회수 -->
            <td class="py-4 px-5 text-center text-stone-500 font-mono text-xs sm:text-sm">
              <%= number_with_delimiter(notice.view_count) %>
            </td>
      
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>