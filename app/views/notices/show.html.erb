<% content_for :title, @notice.title %>

<div class="w-full max-w-4xl mx-auto py-8 px-4">
  <!-- 상단 목록으로 돌아가기 버튼 -->
  <div class="mb-6">
    <%= link_to notices_path,
        class: "inline-flex items-center gap-2 text-sm font-semibold text-stone-500 hover:text-emerald-700 transition duration-150" do
    %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      공지사항 목록으로 돌아가기
    <% end %>
  </div>

  <!-- 공지사항 카드 -->
  <article class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <!-- 공지사항 헤더 -->
    <header class="p-6 md:p-8 bg-stone-50 border-b border-stone-200">
      <div class="flex items-center gap-2 mb-3">
        <% if @notice.is_pinned? %>
          <span class="bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-md border border-amber-200">
            [중요] 필독
          </span>
        <% end %>
        <span class="text-xs font-medium text-stone-400">
          등록일: <%= @notice.created_at.strftime("%Y-%m,-%d") %>
        </span>
        <span class="text-xs text-stone-300">•</span>
        <span class="text-xs font-medium text-stone-400">
          조회수: <%= @notice.view_count %>회
        </span>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold text-stone-900 leading-snug tracking-tight">
        <%= @notice.title %>
      </h1>
    </header>

    <!-- 본문 영역 -->
    <div class="p-6 md:p-8 text-stone-700 text-base leading-relaxed whitespace-pre-line min-h-[240px]">
      <%= @notice.content %>
    </div>

    <!-- 하단 버튼 영역 -->
    <footer class="p-6 bg-stone-50 border-t border-stone-100 flex justify-between items-center">
      <%= link_to "목록보기", notices_path,
          class: "px-5 py-2.5 rounded-xl border border-stone-300 text-stone-700 font-semibold text-sm hover:bg-stone-100 transition duration-150"
      %>
    </footer>
  </article>
</div>