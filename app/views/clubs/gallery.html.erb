<% content_for :title, "동아리 활동 갤러리" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <!-- 동아리 활동 갤러리 타이틀 섹션 -->
  <div class="border-b border-stone-200 pb-8 mb-8">
    <div class="flex items-center gap-2 text-emerald-700 font-semibold text-sm mb-2">
      <span>📸</span>
      <span>배움과 나눔의 현장</span>
    </div>
    <h1 class="text-3xl font-extrabold text-stone-900 sm:text-4xl sm:tracking-tight">
      롱라이프 평생학습관 학습동아리 활동 갤러리
    </h1>
    <p class="mt-2 text-base text-stone-500 max-w-3xl leading-relaxed">
      평생학습 동아리 회원들이 함께 배우고 활동하며 만들어간 소중한 순간과 성과를 소개합니다!
    </p>
  </div>

  <!-- DB 데이터 유무에 따라 동작하는 기본 동적 카드 및 디자인 -->
  <% if @activities.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @activities.each do |activity| %>
        <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden hover:shadow-md transition-all duration-300 group">

          <!-- 이미지 카드 상단 -->
          <div class="relative h-52 bg-stone-100 overflow-hidden">
            <% if activity.image_url.present? %>
              <img src="<%= activity.image_url %>"
                   alt="<%= activity.title %>" 
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
            <% else %>
              <!-- 기본 썸네일 -->
              <div class="w-full h-full flex flex-col items-center justify-center bg-stone-100 text-stone-400 group-hover:scale-105 transition-transform duration-300">
                <span class="text-4xl mb-1">🖼️</span>
                <span class="text-xs font-medium">활동 사진</span>
              </div>
            <% end %>

          <!-- 동아리 이름 배지 -->
            <div class="absolute top-3 left-3">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-stone-900/80 text-white backdrop-blur-md">
                🤝 <%= activity.club&.name || "자율 동아리" %>
              </span>
            </div>
          </div>

          <!-- 카드 본문 -->
          <div class="p-6">
            <div class="flex items-center text-xs text-stone-400 mb-2 gap-2">
              <span>📅 <%= activity.activity_date&.strftime("%Y년 %m월 %d일") || Time.current.strftime("%Y년 %m월 %d일") %></span>
            </div>

            <h3 class="text-lg font-bold text-stone-900 group-hover:text-emerald-700 transition duration-150 line-clamp-1 mb-2">
              <%= activity.title %>
            </h3>

            <p class="text-stone-600 text-sm line-clamp-2 leading-relaxed">
              <%= activity.content %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- 데이터가 없을 때 표시되는 안내 영역 -->
    <div class="text-center py-16 bg-stone-50 rounded-2xl border border-dashed border-stone-300">
      <div class="text-4xl mb-3">🖼️</div>
      <h3 class="text-lg font-bold text-stone-800 mb-1">등록된 동아리 활동 소식이 없습니다.</h3>
      <p class="text-sm text-stone-500">동아리 활동 현장과 소식이 등록되는 대로 이곳에 표시됩니다.</p>
    </div>
  <% end %>
</div>