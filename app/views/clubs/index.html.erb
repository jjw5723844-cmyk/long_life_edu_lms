<% content_for :title, "학습동아리" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

  <!-- 상단 헤더 섹션(학습동아리 소개 타이틀, 신규 동아리 개설 버튼) -->
  <div class="md:flex md:items-center md:justify-between border-b border-stone-200 pb-8 mb-8">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 text-emerald-700 font-semibold text-sm mb-2">
        <span>🤝</span>
        <span>자율 학습 공동체</span>
      </div>
      <h1 class="text-3xl font-extrabold text-stone-900 sm:text-4xl sm:tracking-tight">
        학습동아리 소개 & 모집
      </h1>
      <p class="mt-2 text-base text-stone-500 max-w-3xl leading-relaxed">
        배움을 통해 함께 성장하는 롱라이프 평생학습관의 학습동아리를 소개합니다. 다양한 취미를 함께 즐기고 싶으신 지역 주민들과 함께 자율적인 학습 소모임에 참여하고 자신의 역량을 키워보세요!
      </p>
    </div>
    <div class="mt-6 md:mt-0 md:ml-4 flex items-center">
      <%= link_to new_club_path,
          class: "inline-flex items-center px-5 py-3 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-emerald-700 hover:bg-emerald-800 transition duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-600" do
      %>
        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        신규 동아리 개설 신청
      <% end %>
    </div>
  </div>

  <!-- 카테고리 필터 태그 및 검색창 영역 -->
  <div class="bg-stone-50 rounded-2xl p-6 mb-10 border border-stone-200">
    <%= from_with url: clubs_path, method: :get, local: true,
        class: "space-y-4 md:space-y-0 md:flex md:items-center md:justify-between md:gap-4" do |f|
    %>

      <!-- 카테고리 태그 -->
      <div class="flex flex-wrap items-center gap-2">
        <% categories = ["전체", "인문/교양", "IT/디지털", "문화/예술", "언어/어학", "시민/교양"] %>
        <% selected_category = params[:category].presence || "전체" %>
        <% categories.each do |cat| %>
          <% active = (selected_category == cat) %>
          <%= link_to cat, clubs_path(category: (cat == "전체" ? nil : cat), query: params[:query]),
              class: "px-4 py-2 rounded-full text-sm font-medium transition duration-150 #{active ? 'bg-emerald-700 text-white shadow-sm' : 'bg-white text-stone-600 hover:bg-stone-200 border border-stone-300'}"
          %>
        <% end %>
      </div>

      <!-- 검색 입력창 -->
      <div class="relative min-w-[280px]">
        <%= f.text_field :query, value: parmas[:query], placeholder: "동아리명 또는 내용 검색...",
            class: "w-full pl-10 pr-4 py-2.5 bg-white border border-stone-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition"
        %>
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 학습동아리 그리드 카드 목록 -->
  <% if @clubs.present? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @clubs.each do |club| %>
        <div class="bg-white rounded-2xl border border-stone-200 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between overflow-hidden group">
          <div class="p-6">
            <!-- 상단 카테고리 태그 및 모집 상태 바 -->
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <%= club.category.presence || "일반" %>
              </span>

              <% if club.status == "모집중" || club.status.blank? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                  🟢 모집중
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-stone-100 text-stone-600">
                  ⚪ <%= club.status %>
                </span>
              <% endif %>
            </div>

            <!-- 동아리 제목 -->
            <h3 class="text-xl font-bold text-stone-900 group-hover:text-emerald-700 transition duration-150 line-clamp-1 mb-2">
              <%= club.name %>
            </h3>

            <!-- 동아리 설명 -->
            <p class="text-stone-600 text-sm line-clamp-2 leading-relaxed mb-6 h-10">
              <%= club.description %>
            </p>

            <!-- 동아리 대표 및 모집 인원 정보-->
            <div class="border-t border-stone-100 pt-4 space-y-2 text-xs text-stone-500">
              <div class="flex items-center justify-between">
                <span class="text-stone-400">동아리 대표</span>
                <span class="font-medium text-stone-700"><%= club.leader_name.presence || "미정" %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-stone-400">모집 인원</span>
                <span class="font-medium text-stone-700">
                  <strong class="text-emerald-700 font-bold"><%= club.current_members || 0 %></strong> / <%= club.max_members || 0 %>명
                </span>
              </div>
            </div>
          </div>

          <!-- 하단 학습동아리 상세 보기 버튼 -->
          <div class="bg-stone-50 px-6 py-4 border-t border-stone-100 flex items-center justify-between">
            <span class="text-xs text-stone-400">자세히 보기</span>
            <%= link_to club_path(club),
                class: "inline-flex items-center text-xs font-bold text-emerald-700 hover:text-emerald-900 transition" do
            %>
              상세정보 & 가입신청
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- 학습동아리 데이터가 없음 또는 검색 결과 없음 상태 문구 -->
    <div class="text-center py-16 bg-stone-50 rounded-2xl border border-dashed border-stone-300">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-stone-800 mb-1">등록된 학습동아리가 없습니다.</h3>
      <p class="text-sm text-stone-500 mb-6">첫 번째 학습동아리의 주인공이 되어보세요!</p>
      <%= link_to new_club_path,
          class: "inline-flex items-center px-4 py-2.5 border border-transparent rounded-xl text-sm font-semibold text-white bg-emerald-700 hover:bg-emerald-800 transition" do
      %>
        🌱 신규 동아리 신청하기
      <% end %>
    </div>
  <% end %>
  
</div>