<!-- 학습동아리 상세 정보/승인/가입 신청 -->
<% content_for :title, @club.name %>

<!-- 상단 헤더 영역 -->
<div class="w-full bg-stone-100 border-b border-stone-200 py-10 px-6">
  <div class="max-w-4xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 bg-stone-200 text-stone-700 font-bold text-xs rounded-md">
          <%= @club.category.presence || "일반" %>
        </span>
        <% if @club.pending? %>
          <span class="px-2.5 py-0.5 bg-stone-200 text-stone-700 font-bold text-xs rounded-md">승인 대기</span>
        <% elsif @club.approved? %>
          <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-md">승인 완료</span>
        <% else %>
          <span class="px-2.5 py-0.5 bg-stone-200 text-stone-600 font-bold text-xs rounded-md">반려됨</span>
        <% end %>
      </div>
      <h1 class="font-bold text-3xl text-stone-900 m-0"><%= @club.name %></h1>
    </div>

    <!-- 하단 액션 버튼 -->
    <div class="flex items-center gap-2">
      <%= link_to clubs_path,
          class: "px-4 py-2.5 bg-white border border-stone-200 hover:bg-stone-50 text-stone-700 font-bold text-xs rounded-xl shadow-sm transition" do
      %>
        목록으로
      <% end %>

      <!-- 이용자 본인 또는 관리자인 경우 수정/삭제 가능 -->
      <% if respond_to?(:current_user) && current_user && (current_user.id == @club.user_id || (current_user.respond_to?(:admin) && current_user.admin?)) %>
        <%= link_to edit_club_path(@club),
            class: "px-4 py-2.5 bg-stone-800 hover:bg-stone-900 text-white font-bold text-xs rounded-xl shadow-sm transition" do
        %>
          수정
        <% end %>
        <%= link_to club_path(@club), data: {turbo_method: :delete, turbo_confirm: "정말 삭제하시겠습니까?"},
            class: "px-4 py-2.5 bg-stone-200 hover:bg-stone-300 text-stone-800 font-bold text-xs rounded-xl shadow-sm transition" do
        %>
          삭제
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- 상세 내용 -->
<div class="max-w-4xl mx-auto py-10 px-6 space-y-6">
  <!-- 요약 정보 -->
  <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-sm grid grid-cols-2 sm:grid-cols-4 gap-4 text-center divide-x divide-stone-100">
    <div class="p-2">
      <span class="block text-xs font-semibold text-stone-400 mb-1">대표자</span>
      <strong class="text-sm font-bold text-stone-800"><%= @club.leader_name.presence || @club.user&.name || "미지정" %></strong>
    </div>

    <div class="p-2">
      <span class="block text-xs font-semibold text-stone-400 mb-1">현재 인원</span>
      <strong class="text-sm font-bold text-emerald-700"><%= @club.current_members || 1 %> 명</strong>
    </div>

    <div class="p-2">
      <span class="block text-xs font-semibold text-stone-400 mb-1">모집 정원</span>
      <strong class="text-sm font-bold text-stone-800"><%= @club.max_members || "제한없음" %> 명</strong>
    </div>

    <div class="p-2">
      <span class="block text-xs font-semibold text-stone-400 mb-1">신청 일자</span>
      <strong class="text-sm font-bold text-stone-800"><%= @club.created_at.strftime("%Y-%m-%d") %></strong>
    </div>
  </div>

  <!-- 동아리 소개 -->
  <div class="bg-white border border-stone-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
    <h2 class="font-bold text-base text-stone-900 border-b border-stone-100 pb-3">📌 동아리 소개 및 활동 내용</h2>
    <div class="text-sm text-stone-700 leading-relaxed whitespace-pre-line min-h-[120px]">
      <%= @club.description.presence || "등록된 상세 소개 내용이 없습니다." %>
    </div>
  </div>

  <!-- 동아리 가입 신청 섹션 -->
  <div class="bg-stone-50 border border-stone-200 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      <h3 class="font-bold text-sm text-stone-900">해당 동아리에 참여하고 싶으신가요?</h3>
      <p class="text-xs text-stone-500 mt-1">가입 신청을 제출하시면 동아리 대표자 승인 후 활동에 참여하실 수 있습니다.</p>
    </div>
    <%= button_to join_club_path(@club), method: :post,
        class: "px-6 py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-xl shadow-sm transition cursor-pointer whitespace-nowrap" do
    %>
      🙋‍♂️ 동아리 가입 신청하기
    <% end %>
  </div>
</div>