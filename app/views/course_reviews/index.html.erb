<% content_for :title, "#{@course.title} - 생생 학습후기 전체보기" %>

<div class="w-full max-w-4xl mx-auto py-8 px-4">
  <div class="mb-6">
    <!-- 강좌 타이틀로 돌아가는 링크 설정 -->
    <%= link_to "#{@course.title} 상세보기로 돌아가기", course_path(@course),
        class: "text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition"
    %>
  </div>

  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-8 mb-6">
    <h1 class="font-bold text-2xl text-stone-900 tracking-tight mb-2">
      💬 <%= @course.title %>
    </h1>
    <!-- 학습자 수강후기 소개 문구 -->
    <p class="text-stone-500 text-sm">
      학습자분들이 직접 남겨주신 <span class="text-emerald-700 font-bold"><%= @course_reviews.count %>개</span>의 생생한 수강후기입니다.
    </p>
  </div>

  <div class="space-y-4">
    <% if @course_reviews.any? %>
      <% @course_reviews.each do |review| %>
        <div class="p-6 rounded-2xl bg-white border border-stone-200 shadow-sm flex justify-between items-start">
          <div>
            <!-- 5점 척도 기반 별표 이모티콘 점수 표기 -->
            <div class="flex items-center gap-3 mb-3">
              <span class="text-amber-500 font-bold text-sm">
                <%= "★" * review.rating %>
                <%= "☆" * (5 - review.rating) %>
              </span>
              <!-- 수강후기를 남긴 학습자의 명칭 및 수강평을 남긴 시간 표시 -->
              <span class="text-xs font-semibold text-stone-700"><%= review.user.name %>님</span>
              <span class="text-xs text-stone-400"><%= review.created_at.strftime("%Y-%m-%d %H:%M") %></span>
            </div>
            <p class="text-stone-600 text-sm whitespace-pre-line leading-relaxed"><%= review.content %></p>
          </div>

          <!-- 수강후기 삭제 버튼 및 안내 문구 팝업 -->
          <% if current_user == review.user %>
            <%= button_to "삭제", course_course_review_path(@course, review),
                method: :delete,
                data: { confirm: "정말 이 수강후기를 삭제하시겠습니까?" },
                class: "text-xs font-semibold text-stone-400 hover:text-rose-600 bg-transparent border-0 cursor-pointer p-1 transition"
            %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-12 bg-white border border-dashed border-stone-200 rounded-2xl">
        <p class="text-sm text-stone-400 italic">아직 작성된 학습 후기가 없습니다.</p>
      </div>
    <% end %>
  </div>
</div>